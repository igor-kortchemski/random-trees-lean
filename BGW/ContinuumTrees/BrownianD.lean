/-!
# Brownian motion and bridge laws on Skorokhod space

The constructed Brownian motion and Brownian bridge are viewed as probability laws on the
Skorokhod space through the continuous-path embedding. The bridge prefix law is compared with
Brownian motion by its Gaussian density.

## References

* P. Billingsley, *Convergence of Probability Measures*, 2nd ed., Wiley, 1999,
  Sections 8 and 12.
* D. Revuz and M. Yor, *Continuous Martingales and Brownian Motion*, 3rd ed., Springer, 1999,
  Chapter I.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BGW.ContinuumTrees.BrownianD

open BGW.Skorokhod

/-- Anchored Brownian path on `[0,T]` as a continuous function, from the constructed
`ProbabilityTheory.brownian`. -/
noncomputable def brownianPath (T : ℝ) (ω : ℝ≥0 → ℝ) : C(Set.Icc (0 : ℝ) T, ℝ) where
  toFun t := brownian ⟨t.1, t.2.1⟩ ω - brownian 0 ω
  continuous_toFun := by
    let τ : Set.Icc (0 : ℝ) T → ℝ≥0 := fun t => ⟨(t : ℝ), t.property.1⟩
    have hτ : Continuous τ := continuous_subtype_val.subtype_mk _
    change Continuous ((brownian · ω).comp τ - fun _ => brownian 0 ω)
    exact ((continuous_brownian ω).comp hτ).sub continuous_const

/-- Continuous paths are Borel-measurably embedded in Skorokhod space. -/
theorem measurable_ofContinuous {T : ℝ} :
    Measurable (ofContinuous : C(Set.Icc (0 : ℝ) T, ℝ) → D T ℝ) :=
  BGW.Skorokhod.measurable_ofContinuous

/-- Restriction `D T ℝ → D a ℝ` is Borel measurable (both σ-algebras are generated by
evaluations). -/
theorem measurable_restrict {T a : ℝ} (haT : a ≤ T) :
    Measurable (restrict (E := ℝ) haT) :=
  BGW.Skorokhod.measurable_restrict haT

/-- The anchored Brownian path map is measurable. -/
@[fun_prop] theorem measurable_brownianPath (T : ℝ) : Measurable (brownianPath T) := by
  apply ContinuousMap.measurable_iff_eval.mpr
  intro t
  have hconst : Measurable (fun ω : ℝ≥0 → ℝ => brownian 0 ω) := by fun_prop
  exact (measurable_brownian ⟨(t : ℝ), t.property.1⟩).sub hconst

/-- The law of `c · B` on `[0,T]` in `C([0,T], ℝ)`. -/
noncomputable def wienerPathLaw (c : ℝ≥0) (T : ℝ) :
    ProbabilityMeasure C(Set.Icc (0 : ℝ) T, ℝ) :=
  ⟨Measure.map (fun ω => (c : ℝ) • brownianPath T ω) gaussianLimit, inferInstance⟩

/-- The law of `c · B` on `[0,T]` as a probability measure on `D([0,T], ℝ)`: Brownian motion with
variance `c² t`, pushed forward by `ofContinuous`. -/
noncomputable def wienerD (c : ℝ≥0) (T : ℝ) : ProbabilityMeasure (D T ℝ) :=
  ⟨Measure.map ofContinuous
    (wienerPathLaw c T : Measure C(Set.Icc (0 : ℝ) T, ℝ)), inferInstance⟩

/-- The law of `c ·` (standard Brownian bridge) on `D([0,1], ℝ)`, pushed forward from
`BrownianBridge.law` by scaling and `ofContinuous`. -/
noncomputable def bridgeD (c : ℝ≥0) : ProbabilityMeasure (D 1 ℝ) :=
  ⟨Measure.map (fun g : C(unitInterval, ℝ) => ofContinuous (T := 1) ((c : ℝ) • g))
    (BrownianBridge.law : Measure C(unitInterval, ℝ)), inferInstance⟩

/-- The measure underlying `wienerD` is the stated continuous-path pushforward. -/
theorem coe_wienerD (c : ℝ≥0) (T : ℝ) :
    (wienerD c T : Measure (D T ℝ)) =
      Measure.map ofContinuous (wienerPathLaw c T : Measure C(Set.Icc (0 : ℝ) T, ℝ)) := rfl

/-- The law is carried by continuous paths. -/
theorem ae_mem_range_ofContinuous_wienerD (c : ℝ≥0) (T : ℝ) :
    ∀ᵐ f ∂(wienerD c T : Measure (D T ℝ)),
      f ∈ Set.range (ofContinuous : C(Set.Icc (0 : ℝ) T, ℝ) → D T ℝ) := by
  rw [coe_wienerD]
  apply (MeasureTheory.ae_map_iff measurable_ofContinuous.aemeasurable
    (MeasureTheory.measurableSet_range_of_continuous_injective
      (lipschitzWith_one_ofContinuous.continuous) (by
        intro f g h
        exact ContinuousMap.ext fun t => by
          simpa [ofContinuous] using congrArg (fun q : D T ℝ => q t) h))).2
  exact Filter.Eventually.of_forall fun _ => ⟨_, rfl⟩

private theorem isGaussianProcess_scaledBrownianPath (c : ℝ≥0) (T : ℝ) :
    IsGaussianProcess (fun t : Set.Icc (0 : ℝ) T => fun ω =>
      (c : ℝ) * brownianPath T ω t) gaussianLimit := by
  let τ : Set.Icc (0 : ℝ) T → ℝ≥0 := fun t => ⟨(t : ℝ), t.property.1⟩
  apply isGaussianProcess_brownian.of_isGaussianProcess
  intro t
  refine ⟨{τ t, 0},
    { toFun := fun x => (c : ℝ) * (x ⟨τ t, by simp⟩ - x ⟨0, by simp⟩)
      map_add' := ?_
      map_smul' := ?_ }, ?_⟩
  · intro x y
    simp only [Pi.add_apply]
    ring
  · intro a x
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    ring
  · simp [brownianPath, τ]

private theorem measurable_scaledBrownianPath (c : ℝ≥0) (T : ℝ) :
    Measurable (fun ω => (c : ℝ) • brownianPath T ω) := by
  apply ContinuousMap.measurable_iff_eval.mpr
  intro t
  have hτ : Measurable (fun ω : ℝ≥0 → ℝ => brownian ⟨(t : ℝ), t.property.1⟩ ω -
      brownian 0 ω) := by fun_prop
  change Measurable (fun ω => (c : ℝ) * brownianPath T ω t)
  simpa [brownianPath] using hτ.const_mul (c : ℝ)

private theorem hasLaw_scaledBrownianPath (c : ℝ≥0) (T : ℝ) :
    HasLaw (fun ω => (c : ℝ) • brownianPath T ω)
      (wienerPathLaw c T : Measure C(Set.Icc (0 : ℝ) T, ℝ)) gaussianLimit where
  aemeasurable := (measurable_scaledBrownianPath c T).aemeasurable
  map_eq := rfl

private theorem hasLaw_wienerDPath (c : ℝ≥0) (T : ℝ) :
    HasLaw (fun ω => ofContinuous ((c : ℝ) • brownianPath T ω))
      (wienerD c T : Measure (D T ℝ)) gaussianLimit := by
  refine ⟨(measurable_ofContinuous.comp (measurable_scaledBrownianPath c T)).aemeasurable, ?_⟩
  change Measure.map (fun ω => ofContinuous ((c : ℝ) • brownianPath T ω)) gaussianLimit =
    Measure.map ofContinuous
      (Measure.map (fun ω => (c : ℝ) • brownianPath T ω) gaussianLimit)
  have hfun : (fun ω => ofContinuous ((c : ℝ) • brownianPath T ω)) =
      ofContinuous ∘ (fun ω => (c : ℝ) • brownianPath T ω) := rfl
  rw [hfun, ← Measure.map_map measurable_ofContinuous
    (measurable_scaledBrownianPath c T)]

/-- Brownian motion starts at zero. -/
theorem ae_eval_zero_wienerD (c : ℝ≥0) {T : ℝ} (hT : 0 ≤ T) :
    ∀ᵐ f ∂(wienerD c T : Measure (D T ℝ)), f ⟨0, le_rfl, hT⟩ = 0 := by
  let t₀ : Set.Icc (0 : ℝ) T := ⟨0, le_rfl, hT⟩
  have hp : Measurable (fun f : D T ℝ => f t₀ = 0) := (measurable_eval t₀).eq_const 0
  have heq : (fun f : D T ℝ => f ⟨0, le_rfl, hT⟩ = 0) = fun f => f t₀ = 0 := rfl
  rw [heq]
  apply ((hasLaw_wienerDPath c T).ae_iff hp).1
  change ∀ᵐ ω ∂gaussianLimit,
    (c : ℝ) * (brownian 0 ω - brownian 0 ω) = 0
  exact Filter.Eventually.of_forall fun _ => by simp

/-- All finite-dimensional laws are centered Gaussian. -/
theorem isGaussianProcess_eval_wienerD (c : ℝ≥0) (T : ℝ) :
    IsGaussianProcess (fun (t : Set.Icc (0 : ℝ) T) (f : D T ℝ) => f t)
      (wienerD c T : Measure (D T ℝ)) where
  hasGaussianLaw J := by
    have heval : Measurable (fun f : D T ℝ => fun t : J => f t.val) :=
      Measurable.of_eval fun t => measurable_eval t.val
    have hmap : Measure.map (fun f : D T ℝ => fun t : J => f t.val)
        (wienerD c T : Measure (D T ℝ)) =
      Measure.map (fun ω => fun t : J => (c : ℝ) * brownianPath T ω t.val) gaussianLimit := by
      rw [← (hasLaw_wienerDPath c T).map_eq,
        AEMeasurable.map_map_of_aemeasurable
          ((hasLaw_wienerDPath c T).map_eq ▸ heval.aemeasurable)
          (hasLaw_wienerDPath c T).aemeasurable]
      rfl
    refine ⟨heval.aemeasurable, ?_⟩
    change IsGaussian (Measure.map (fun f : D T ℝ => fun t : J => f t.val)
      (wienerD c T : Measure (D T ℝ)))
    rw [hmap]
    exact (isGaussianProcess_scaledBrownianPath c T).hasGaussianLaw J |>.isGaussian_map

/-- The continuous-path and Skorokhod versions have the same Brownian evaluations. -/
private theorem covariance_scaledBrownianPath (c : ℝ≥0) (T : ℝ)
    (s t : Set.Icc (0 : ℝ) T) :
    cov[fun ω => (c : ℝ) * brownianPath T ω s,
      fun ω => (c : ℝ) * brownianPath T ω t; gaussianLimit] =
        (c : ℝ) ^ 2 * min (s : ℝ) (t : ℝ) := by
  have hmem (u : ℝ≥0) := (isGaussianProcess_brownian.hasGaussianLaw_eval u).memLp_two
  let s' : ℝ≥0 := ⟨(s : ℝ), (Set.mem_Icc.mp s.property).1⟩
  let t' : ℝ≥0 := ⟨(t : ℝ), (Set.mem_Icc.mp t.property).1⟩
  have hraw : cov[fun ω => brownian s' ω - brownian 0 ω,
      fun ω => brownian t' ω - brownian 0 ω; gaussianLimit] =
      min (s : ℝ) (t : ℝ) := by
    rw [covariance_fun_sub_fun_sub (hmem s') (hmem 0) (hmem t') (hmem 0)]
    rw [covariance_brownian s' t', covariance_brownian s' 0,
      covariance_brownian 0 t', covariance_brownian 0 0]
    rw [min_eq_right (show (0 : ℝ≥0) ≤ s' from bot_le),
      min_eq_left (show (0 : ℝ≥0) ≤ t' from bot_le)]
    rw [NNReal.coe_min]
    simp only [min_self, NNReal.coe_zero, sub_zero, add_zero]
    rfl
  change cov[fun ω => (c : ℝ) * (brownian s' ω - brownian 0 ω),
    fun ω => (c : ℝ) * (brownian t' ω - brownian 0 ω); gaussianLimit] = _
  rw [covariance_const_mul_left, covariance_const_mul_right, hraw]
  ring

/-- The law of the coordinate process on `D` is a centered Gaussian process. -/
theorem integral_eval_wienerD (c : ℝ≥0) {T : ℝ} (t : Set.Icc (0 : ℝ) T) :
    ∫ f : D T ℝ, f t ∂(wienerD c T : Measure (D T ℝ)) = 0 := by
  calc
    ∫ f : D T ℝ, f t ∂(wienerD c T : Measure (D T ℝ)) =
        ∫ ω, (ofContinuous ((c : ℝ) • brownianPath T ω)) t ∂gaussianLimit :=
      ((hasLaw_wienerDPath c T).integral_comp (f := fun f => f t)
        (measurable_eval t).aestronglyMeasurable).symm
    _ = 0 := by
      have hB := isBrownianReal_brownian.toIsPreBrownianReal
      let u : ℝ≥0 := ⟨(t : ℝ), (Set.mem_Icc.mp t.property).1⟩
      change ∫ ω, (c : ℝ) * (brownian u ω - brownian 0 ω) ∂gaussianLimit = 0
      rw [integral_const_mul, integral_sub (hB.integrable_eval u) (hB.integrable_eval 0)]
      simp only [hB.integral_eval, sub_zero, mul_zero]

/-- Covariance `c² min(s,t)`. -/
theorem covariance_eval_wienerD (c : ℝ≥0) {T : ℝ} (s t : Set.Icc (0 : ℝ) T) :
    cov[fun f : D T ℝ => f s, fun f : D T ℝ => f t; (wienerD c T : Measure (D T ℝ))] =
      (c : ℝ) ^ 2 * min (s : ℝ) (t : ℝ) := by
  calc
    cov[fun f : D T ℝ => f s, fun f : D T ℝ => f t;
      (wienerD c T : Measure (D T ℝ))] =
        cov[fun ω => (ofContinuous ((c : ℝ) • brownianPath T ω)) s,
          fun ω => (ofContinuous ((c : ℝ) • brownianPath T ω)) t; gaussianLimit] :=
      (hasLaw_wienerDPath c T).covariance_comp (measurable_eval s).aemeasurable
        (measurable_eval t).aemeasurable |>.symm
    _ = (c : ℝ) ^ 2 * min (s : ℝ) (t : ℝ) := covariance_scaledBrownianPath c T s t

/-- Variance of the scaled Brownian motion at time `t`, with negative times truncated to zero. -/
noncomputable def variance (c : ℝ≥0) (t : ℝ) : ℝ≥0 := c ^ 2 * Real.toNNReal t

/-- Gaussian law of one Brownian evaluation on Skorokhod space. -/
private theorem map_eval_wienerD (c : ℝ≥0) {T : ℝ} (t : Set.Icc (0 : ℝ) T) :
    (wienerD c T : Measure (D T ℝ)).map (fun f : D T ℝ => f t) =
      gaussianReal 0 (variance c (t : ℝ)) := by
  let hEval : Measurable (fun f : D T ℝ => f t) := measurable_eval t
  have hvar : Var[fun f : D T ℝ => f t; (wienerD c T : Measure (D T ℝ))] =
      (c : ℝ) ^ 2 * (t : ℝ) := by
    rw [← covariance_self hEval.aemeasurable, covariance_eval_wienerD, min_self]
  have hmap := (isGaussianProcess_eval_wienerD c T).hasGaussianLaw_eval t
    |>.map_eq_gaussianReal
  rw [integral_eval_wienerD, hvar] at hmap
  have htoNN : ((c : ℝ) ^ 2 * (t : ℝ)).toNNReal = variance c (t : ℝ) := by
    rw [Real.toNNReal_mul (by positivity),
      Real.toNNReal_of_nonneg (sq_nonneg (c : ℝ))]
    rfl
  simpa [htoNN] using hmap

private theorem indepFun_wienerResidual_endpoint {c : ℝ≥0} {a : ℝ} (ha : 0 < a)
    (s : Finset (Set.Icc (0 : ℝ) a)) :
    IndepFun
      (fun f : D a ℝ => fun t : s => f t.val - ((t.val : ℝ) / a) * f ⟨a, ha.le, le_rfl⟩)
      (fun f : D a ℝ => f ⟨a, ha.le, le_rfl⟩) (wienerD c a : Measure (D a ℝ)) := by
  refine indepFun_residual_endpoint (X := fun t : Set.Icc (0 : ℝ) a => fun f : D a ℝ => f t)
    (isGaussianProcess_eval_wienerD c a) (fun t => measurable_eval t) (fun t : s => t.val)
    ⟨a, ha.le, le_rfl⟩ (fun t => (t.val : ℝ) / a) ?_
  intro t
  rw [covariance_eval_wienerD, covariance_eval_wienerD, min_eq_left t.val.property.2, min_self]
  field_simp [ne_of_gt ha]

/-- The `√2` normalization has Laplace transform `exp(t l²)`. -/
theorem integral_exp_neg_eval_wienerD_sqrt_two {T : ℝ} (t : Set.Icc (0 : ℝ) T) (l : ℝ) :
    ∫ f : D T ℝ, Real.exp (-l * f t)
      ∂(wienerD (NNReal.sqrt 2) T : Measure (D T ℝ)) =
      Real.exp ((t : ℝ) * l ^ 2) := by
  let c : ℝ≥0 := NNReal.sqrt 2
  have hlaw : HasLaw (fun f : D T ℝ => f t)
      (gaussianReal 0 (variance c (t : ℝ))) (wienerD c T : Measure (D T ℝ)) :=
    ⟨(measurable_eval t).aemeasurable, map_eval_wienerD c t⟩
  have hmgf := mgf_gaussianReal hlaw (-l)
  have hvariance : variance c (t : ℝ) = 2 * Real.toNNReal (t : ℝ) := by
    simp [variance, c, NNReal.sq_sqrt]
  change ∫ f : D T ℝ, Real.exp ((-l) * f t)
      ∂(wienerD c T : Measure (D T ℝ)) = _
  rw [← mgf, hmgf, hvariance]
  simp [Real.toNNReal_of_nonneg (Set.mem_Icc.mp t.property).1]
  ring_nf

/-- The measure underlying `bridgeD` is the stated continuous-path pushforward. -/
theorem coe_bridgeD (c : ℝ≥0) :
    (bridgeD c : Measure (D 1 ℝ)) =
      Measure.map (fun g : C(unitInterval, ℝ) =>
        ofContinuous (T := 1) ((c : ℝ) • g))
      (BrownianBridge.law : Measure C(unitInterval, ℝ)) := rfl

private theorem measurable_scaledBridgePath (c : ℝ≥0) :
    Measurable (fun g : C(unitInterval, ℝ) => (c : ℝ) • g) := by
  fun_prop

private theorem hasLaw_bridgeDPath (c : ℝ≥0) :
    HasLaw (fun g : C(unitInterval, ℝ) => ofContinuous (T := 1) ((c : ℝ) • g))
      (bridgeD c : Measure (D 1 ℝ)) (BrownianBridge.law : Measure C(unitInterval, ℝ)) := by
  refine ⟨(measurable_ofContinuous.comp (measurable_scaledBridgePath c)).aemeasurable, ?_⟩
  rfl

/-- The law is carried by continuous paths. -/
theorem ae_mem_range_ofContinuous_bridgeD (c : ℝ≥0) :
    ∀ᵐ f ∂(bridgeD c : Measure (D 1 ℝ)),
      f ∈ Set.range (ofContinuous : C(Set.Icc (0 : ℝ) 1, ℝ) → D 1 ℝ) := by
  have hrange : MeasurableSet (Set.range (ofContinuous :
      C(Set.Icc (0 : ℝ) 1, ℝ) → D 1 ℝ)) :=
    MeasureTheory.measurableSet_range_of_continuous_injective
      (lipschitzWith_one_ofContinuous.continuous) (by
        intro f g h
        exact ContinuousMap.ext fun t => by
          simpa [ofContinuous] using congrArg (fun q : D 1 ℝ => q t) h)
  have hp : Measurable (fun f : D 1 ℝ => f ∈
      Set.range (ofContinuous : C(Set.Icc (0 : ℝ) 1, ℝ) → D 1 ℝ)) :=
    measurableSet_setOfPred.mp hrange
  apply ((hasLaw_bridgeDPath c).ae_iff hp).1
  exact Filter.Eventually.of_forall fun _ => ⟨_, rfl⟩

/-- Both endpoints of the bridge vanish almost surely. -/
theorem ae_endpoints_bridgeD (c : ℝ≥0) :
    ∀ᵐ f ∂(bridgeD c : Measure (D 1 ℝ)),
      f ⟨0, by norm_num, by norm_num⟩ = 0 ∧ f ⟨1, by norm_num, le_rfl⟩ = 0 := by
  let t₀ : Set.Icc (0 : ℝ) 1 := ⟨0, by norm_num, by norm_num⟩
  let t₁ : Set.Icc (0 : ℝ) 1 := ⟨1, by norm_num, le_rfl⟩
  have h0 : MeasurableSet {f : D 1 ℝ | f t₀ = 0} :=
    (measurable_eval t₀) (measurableSet_singleton 0)
  have h1 : MeasurableSet {f : D 1 ℝ | f t₁ = 0} :=
    (measurable_eval t₁) (measurableSet_singleton 0)
  have hset : MeasurableSet {f : D 1 ℝ | f t₀ = 0 ∧ f t₁ = 0} := by
    rw [Set.ofPred_and]
    exact h0.inter h1
  have hp : Measurable (fun f : D 1 ℝ => f t₀ = 0 ∧ f t₁ = 0) :=
    measurableSet_setOfPred.mp hset
  apply ((hasLaw_bridgeDPath c).ae_iff hp).1
  filter_upwards [BrownianBridge.ae_endpoints] with g hg
  constructor
  · have hg0 : g t₀ = 0 := by change g 0 = 0; exact hg.1
    change (c : ℝ) * g t₀ = 0
    rw [hg0]
    simp
  · have hg1 : g t₁ = 0 := by change g 1 = 0; exact hg.2
    change (c : ℝ) * g t₁ = 0
    rw [hg1]
    simp

private theorem isGaussianProcess_scaledBridgePath (c : ℝ≥0) :
    IsGaussianProcess (fun t : unitInterval => fun g : C(unitInterval, ℝ) =>
      (c : ℝ) * g t) (BrownianBridge.law : Measure C(unitInterval, ℝ)) :=
  BrownianBridge.isGaussianProcess_eval.smul fun _ => (c : ℝ)

/-- All finite dimensional bridge evaluations are centered Gaussian. -/
theorem isGaussianProcess_eval_bridgeD (c : ℝ≥0) :
    IsGaussianProcess (fun (t : Set.Icc (0 : ℝ) 1) (f : D 1 ℝ) => f t)
      (bridgeD c : Measure (D 1 ℝ)) where
  hasGaussianLaw J := by
    have heval : Measurable (fun f : D 1 ℝ => fun t : J => f t.val) :=
      Measurable.of_eval fun t => measurable_eval t.val
    have hmap : Measure.map (fun f : D 1 ℝ => fun t : J => f t.val)
        (bridgeD c : Measure (D 1 ℝ)) =
      Measure.map (fun g : C(unitInterval, ℝ) => fun t : J => (c : ℝ) * g t.val)
        (BrownianBridge.law : Measure C(unitInterval, ℝ)) := by
      rw [← (hasLaw_bridgeDPath c).map_eq,
        AEMeasurable.map_map_of_aemeasurable
          ((hasLaw_bridgeDPath c).map_eq ▸ heval.aemeasurable)
          (hasLaw_bridgeDPath c).aemeasurable]
      rfl
    refine ⟨heval.aemeasurable, ?_⟩
    change IsGaussian (Measure.map (fun f : D 1 ℝ => fun t : J => f t.val)
      (bridgeD c : Measure (D 1 ℝ)))
    rw [hmap]
    exact (isGaussianProcess_scaledBridgePath c).hasGaussianLaw J |>.isGaussian_map

/-- Every bridge evaluation has mean zero. -/
theorem integral_eval_bridgeD (c : ℝ≥0) (t : Set.Icc (0 : ℝ) 1) :
    ∫ f : D 1 ℝ, f t ∂(bridgeD c : Measure (D 1 ℝ)) = 0 := by
  calc
    ∫ f : D 1 ℝ, f t ∂(bridgeD c : Measure (D 1 ℝ)) =
        ∫ g : C(unitInterval, ℝ), (ofContinuous (T := 1) ((c : ℝ) • g)) t
          ∂(BrownianBridge.law : Measure C(unitInterval, ℝ)) :=
      ((hasLaw_bridgeDPath c).integral_comp (f := fun f => f t)
        (measurable_eval t).aestronglyMeasurable).symm
    _ = 0 := by
      change ∫ g : C(unitInterval, ℝ), (c : ℝ) * g t
        ∂(BrownianBridge.law : Measure C(unitInterval, ℝ)) = 0
      rw [integral_const_mul, BrownianBridge.integral_eval]
      simp

private theorem covariance_scaledBridgePath (c : ℝ≥0) (s t : unitInterval) :
    cov[fun g : C(unitInterval, ℝ) => (c : ℝ) * g s,
      fun g => (c : ℝ) * g t; (BrownianBridge.law : Measure C(unitInterval, ℝ))] =
        (c : ℝ) ^ 2 * (min (s : ℝ) (t : ℝ) - (s : ℝ) * (t : ℝ)) := by
  rw [covariance_const_mul_left, covariance_const_mul_right, BrownianBridge.covariance_eval]
  ring

/-- Covariance `c² (min(s,t) - s t)`. -/
theorem covariance_eval_bridgeD (c : ℝ≥0) (s t : Set.Icc (0 : ℝ) 1) :
    cov[fun f : D 1 ℝ => f s, fun f : D 1 ℝ => f t; (bridgeD c : Measure (D 1 ℝ))] =
      (c : ℝ) ^ 2 * (min (s : ℝ) (t : ℝ) - (s : ℝ) * (t : ℝ)) := by
  calc
    cov[fun f : D 1 ℝ => f s, fun f : D 1 ℝ => f t;
      (bridgeD c : Measure (D 1 ℝ))] =
        cov[fun g : C(unitInterval, ℝ) => (ofContinuous (T := 1) ((c : ℝ) • g)) s,
          fun g => (ofContinuous (T := 1) ((c : ℝ) • g)) t;
          (BrownianBridge.law : Measure C(unitInterval, ℝ))] :=
      (hasLaw_bridgeDPath c).covariance_comp (measurable_eval s).aemeasurable
        (measurable_eval t).aemeasurable |>.symm
    _ = (c : ℝ) ^ 2 * (min (s : ℝ) (t : ℝ) - (s : ℝ) * (t : ℝ)) :=
      covariance_scaledBridgePath c s t

/-- Gaussian law of one bridge evaluation on Skorokhod space. -/
theorem map_eval_bridgeD (c : ℝ≥0) (t : Set.Icc (0 : ℝ) 1) :
    (bridgeD c : Measure (D 1 ℝ)).map (fun f : D 1 ℝ => f t) =
      gaussianReal 0
        (c ^ 2 * ⟨(t : ℝ) * (1 - t), mul_nonneg t.2.1 (sub_nonneg.2 t.2.2)⟩) := by
  let hEval : Measurable (fun f : D 1 ℝ => f t) := measurable_eval t
  have hvar : Var[fun f : D 1 ℝ => f t; (bridgeD c : Measure (D 1 ℝ))] =
      (c : ℝ) ^ 2 * ((t : ℝ) * (1 - t)) := by
    rw [← covariance_self hEval.aemeasurable, covariance_eval_bridgeD, min_self]
    ring
  have hmap := (isGaussianProcess_eval_bridgeD c).hasGaussianLaw_eval t
    |>.map_eq_gaussianReal
  rw [integral_eval_bridgeD, hvar] at hmap
  have hval : ((c : ℝ) ^ 2 * ((t : ℝ) * (1 - t))).toNNReal =
      c ^ 2 * ⟨(t : ℝ) * (1 - t), mul_nonneg t.2.1 (sub_nonneg.2 t.2.2)⟩ := by
    apply NNReal.coe_injective
    have ht := Set.mem_Icc.mp t.property
    change (((c : ℝ) ^ 2 * ((t : ℝ) * (1 - (t : ℝ)))).toNNReal : ℝ) =
      (c : ℝ) ^ 2 * ((t : ℝ) * (1 - (t : ℝ)))
    rw [Real.coe_toNNReal _ (mul_nonneg (sq_nonneg (c : ℝ))
      (mul_nonneg ht.1 (sub_nonneg.2 ht.2)))]
  simpa [hval] using hmap

private theorem indepFun_bridgeResidual_endpoint {c : ℝ≥0} {a : ℝ} (ha : 0 < a)
    (ha1 : a < 1) (s : Finset (Set.Icc (0 : ℝ) a)) :
    IndepFun
      (fun f : D 1 ℝ => fun t : s =>
        f ⟨t.val, t.val.property.1, t.val.property.2.trans ha1.le⟩ -
          ((t.val : ℝ) / a) * f ⟨a, ha.le, ha1.le⟩)
      (fun f : D 1 ℝ => f ⟨a, ha.le, ha1.le⟩)
      (bridgeD c : Measure (D 1 ℝ)) := by
  refine indepFun_residual_endpoint
    (X := fun t : Set.Icc (0 : ℝ) 1 => fun f : D 1 ℝ => f t)
    (isGaussianProcess_eval_bridgeD c) (fun t => measurable_eval t)
    (fun t : s => ⟨t.val, t.val.property.1, t.val.property.2.trans ha1.le⟩)
    ⟨a, ha.le, ha1.le⟩ (fun t => (t.val : ℝ) / a) ?_
  intro t
  rw [covariance_eval_bridgeD, covariance_eval_bridgeD]
  simp only [min_eq_left t.val.property.2, min_self]
  field_simp [ne_of_gt ha]

private theorem map_wienerResidual_eq_bridgeResidual {c : ℝ≥0} {a : ℝ}
    (ha : 0 < a) (ha1 : a < 1) (s : Finset (Set.Icc (0 : ℝ) a)) :
    Measure.map
        (fun f : D a ℝ => fun t : s =>
          f t.val - ((t.val : ℝ) / a) * f ⟨a, ha.le, le_rfl⟩)
        (wienerD c a : Measure (D a ℝ)) =
      Measure.map
        (fun f : D 1 ℝ => fun t : s =>
          f ⟨t.val, t.val.property.1, t.val.property.2.trans ha1.le⟩ -
            ((t.val : ℝ) / a) * f ⟨a, ha.le, ha1.le⟩)
        (bridgeD c : Measure (D 1 ℝ)) := by
  let e₀ : Set.Icc (0 : ℝ) a := ⟨a, ha.le, le_rfl⟩
  let e₁ : Set.Icc (0 : ℝ) 1 := ⟨a, ha.le, ha1.le⟩
  let uₐ : unitInterval := ⟨a, ha.le, ha1.le⟩
  let u : s → unitInterval := fun t =>
    ⟨t.val, t.val.property.1, t.val.property.2.trans ha1.le⟩
  let R₀ : D a ℝ → s → ℝ := fun f t => f t.val - ((t.val : ℝ) / a) * f e₀
  let R₁ : D 1 ℝ → s → ℝ := fun f t => f ⟨t.val, t.val.property.1,
      t.val.property.2.trans ha1.le⟩ - ((t.val : ℝ) / a) * f e₁
  have hR₀ : Measurable R₀ := Measurable.of_eval fun t =>
    (measurable_eval t.val).sub ((measurable_eval e₀).const_mul ((t.val : ℝ) / a))
  have hR₁ : Measurable R₁ := Measurable.of_eval fun t =>
    (measurable_eval ⟨t.val, t.val.property.1, t.val.property.2.trans ha1.le⟩).sub
      ((measurable_eval e₁).const_mul ((t.val : ℝ) / a))
  have hW : Measure.map R₀ (wienerD c a : Measure (D a ℝ)) =
      Measure.map (fun ω => fun t : s =>
        (c : ℝ) * brownianPath a ω t.val - ((t.val : ℝ) / a) *
          ((c : ℝ) * brownianPath a ω e₀)) gaussianLimit := by
    rw [← (hasLaw_wienerDPath c a).map_eq,
      AEMeasurable.map_map_of_aemeasurable
        ((hasLaw_wienerDPath c a).map_eq ▸ hR₀.aemeasurable)
        (hasLaw_wienerDPath c a).aemeasurable]
    rfl
  have hG : Measurable (fun g : C(unitInterval, ℝ) =>
      R₁ (ofContinuous (T := 1) ((c : ℝ) • g))) :=
    hR₁.comp (measurable_ofContinuous.comp (measurable_scaledBridgePath c))
  have hB : Measure.map R₁ (bridgeD c : Measure (D 1 ℝ)) =
      Measure.map (fun ω => fun t : s =>
        (c : ℝ) * BrownianBridge.path ω (u t) - ((t.val : ℝ) / a) *
          ((c : ℝ) * BrownianBridge.path ω uₐ)) gaussianLimit := by
    rw [← (hasLaw_bridgeDPath c).map_eq,
      AEMeasurable.map_map_of_aemeasurable
        ((hasLaw_bridgeDPath c).map_eq ▸ hR₁.aemeasurable)
        (hasLaw_bridgeDPath c).aemeasurable,
      ← BrownianBridge.hasLaw_path.map_eq,
      AEMeasurable.map_map_of_aemeasurable
        (BrownianBridge.hasLaw_path.map_eq ▸ hG.aemeasurable)
        BrownianBridge.hasLaw_path.aemeasurable]
    rfl
  have hsource :
      (fun ω => fun t : s =>
        (c : ℝ) * brownianPath a ω t.val - ((t.val : ℝ) / a) *
          ((c : ℝ) * brownianPath a ω e₀)) =
      (fun ω => fun t : s =>
        (c : ℝ) * BrownianBridge.path ω (u t) - ((t.val : ℝ) / a) *
          ((c : ℝ) * BrownianBridge.path ω uₐ)) := by
    funext ω t
    simp [brownianPath, BrownianBridge.path, BrownianBridge.time, e₀, u, uₐ]
    field_simp [ne_of_gt ha]
    ring
  rw [hW, hB, hsource]

/-! ### Prefix density of the bridge with respect to Brownian motion -/

/-- The density `p_{c²(1-a)}(-x) / p_{c²}(0)` of the bridge prefix on `[0,a]` with respect to
Brownian motion on `[0,a]`, evaluated at the terminal value `x = f(a)`. -/
noncomputable def prefixDensity (c : ℝ≥0) (a x : ℝ) : ℝ :=
  gaussianPDFReal 0 (variance c (1 - a)) (-x) / gaussianPDFReal 0 (variance c 1) 0

/-- Explicit form of the prefix density: `(1-a)^{-1/2} exp (-x² / (2 c² (1-a)))`. -/
theorem prefixDensity_eq {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha : a < 1) (x : ℝ) :
    prefixDensity c a x =
      (1 - a) ^ (-(1 / 2 : ℝ)) * Real.exp (-x ^ 2 / (2 * (c : ℝ) ^ 2 * (1 - a))) := by
  have hq : 0 < 1 - a := by linarith
  have hcpos : 0 < (c : ℝ) := NNReal.coe_pos.mpr (pos_iff_ne_zero.mpr hc)
  have hvarA : (variance c (1 - a) : ℝ) = (c : ℝ) ^ 2 * (1 - a) := by
    change (c : ℝ) ^ 2 * (Real.toNNReal (1 - a) : ℝ) = _
    rw [Real.coe_toNNReal _ hq.le]
  have hvar1 : (variance c 1 : ℝ) = (c : ℝ) ^ 2 := by
    simp [variance]
  have hroot : √(2 * Real.pi * ((c : ℝ) ^ 2 * (1 - a))) =
      √(2 * Real.pi * (c : ℝ) ^ 2) * √(1 - a) := by
    rw [show 2 * Real.pi * ((c : ℝ) ^ 2 * (1 - a)) =
      (2 * Real.pi * (c : ℝ) ^ 2) * (1 - a) by ring,
      Real.sqrt_mul (by positivity)]
  have hpow : (1 - a) ^ (-(1 / 2 : ℝ)) = (√(1 - a))⁻¹ := by
    rw [Real.rpow_neg (le_of_lt hq), ← Real.sqrt_eq_rpow]
  change ((√(2 * Real.pi * (variance c (1 - a) : ℝ)))⁻¹ *
      Real.exp (-(-x - 0) ^ 2 / (2 * (variance c (1 - a) : ℝ)))) /
    ((√(2 * Real.pi * (variance c 1 : ℝ)))⁻¹ *
      Real.exp (-(0 - 0) ^ 2 / (2 * (variance c 1 : ℝ)))) = _
  rw [hvarA, hvar1]
  simp only [sub_zero, neg_sq, sub_self, div_eq_mul_inv]
  rw [hroot]
  have hA : √(2 * Real.pi * (c : ℝ) ^ 2) ≠ 0 := by positivity
  have hqroot : √(1 - a) ≠ 0 := by positivity
  field_simp [hA, hqroot]
  rw [hpow]
  simp [hqroot]

private theorem gaussianPDFReal_mul_prefixDensity {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ}
    (ha : 0 < a) (ha1 : a < 1) (x : ℝ) :
    gaussianPDFReal 0 (variance c a) x * prefixDensity c a x =
      gaussianPDFReal 0 (variance c (a * (1 - a))) x := by
  rw [prefixDensity_eq hc ha1 x]
  exact gaussianPDFReal_mul_explicit hc ha ha1 x

private theorem weighted_gaussian_endpoint {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ}
    (ha : 0 < a) (ha1 : a < 1) :
    (gaussianReal 0 (variance c a)).withDensity
      (fun x => ENNReal.ofReal (prefixDensity c a x)) =
      gaussianReal 0 (variance c (a * (1 - a))) := by
  have hcpos : 0 < c := pos_iff_ne_zero.mpr hc
  have hva : variance c a ≠ 0 := by
    have hta : 0 < Real.toNNReal a := by
      rw [Real.toNNReal_of_nonneg ha.le]
      exact NNReal.coe_pos.mpr ha
    exact (mul_pos (pow_pos hcpos 2) hta).ne'
  have hprod : 0 < a * (1 - a) := mul_pos ha (by linarith)
  have hvp : variance c (a * (1 - a)) ≠ 0 := by
    have hta : 0 < Real.toNNReal (a * (1 - a)) := by
      rw [Real.toNNReal_of_nonneg hprod.le]
      exact NNReal.coe_pos.mpr hprod
    exact (mul_pos (pow_pos hcpos 2) hta).ne'
  have hweight : Measurable (fun x : ℝ => ENNReal.ofReal (prefixDensity c a x)) := by
    fun_prop [prefixDensity]
  rw [gaussianReal_of_var_ne_zero 0 hva, gaussianReal_of_var_ne_zero 0 hvp,
    ← withDensity_mul volume (measurable_gaussianPDF 0 (variance c a)) hweight]
  congr 1
  funext x
  change ENNReal.ofReal (gaussianPDFReal 0 (variance c a) x) *
    ENNReal.ofReal (prefixDensity c a x) =
      ENNReal.ofReal (gaussianPDFReal 0 (variance c (a * (1 - a))) x)
  rw [← ENNReal.ofReal_mul (gaussianPDFReal_nonneg _ _ _),
    gaussianPDFReal_mul_prefixDensity hc ha ha1 x]

/-- The prefix density is a probability density for Brownian motion on `[0,a]`. -/
theorem lintegral_prefixDensity_wienerD {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha0 : 0 ≤ a)
    (ha1 : a < 1) :
    ∫⁻ f, ENNReal.ofReal (prefixDensity c a (f ⟨a, ha0, le_rfl⟩))
      ∂(wienerD c a : Measure (D a ℝ)) = 1 := by
  let t : Set.Icc (0 : ℝ) a := ⟨a, ha0, le_rfl⟩
  have heval : Measurable (fun f : D a ℝ => f t) := measurable_eval t
  have hweight : Measurable (fun x : ℝ => ENNReal.ofReal (prefixDensity c a x)) := by
    fun_prop [prefixDensity]
  rw [← lintegral_map hweight heval]
  rw [map_eval_wienerD c t]
  by_cases haz : a = 0
  · subst a
    have hcpos : 0 < c := pos_iff_ne_zero.mpr hc
    have hv1 : variance c 1 ≠ 0 := by
      have hp : 0 < Real.toNNReal (1 : ℝ) := by norm_num
      exact (mul_pos (pow_pos hcpos 2) hp).ne'
    have hzero : prefixDensity c 0 0 = 1 := by
      simp only [prefixDensity, sub_zero, neg_zero]
      exact div_self (gaussianPDFReal_pos _ _ _ hv1).ne'
    simp [t, variance, gaussianReal_zero_var, hzero]
  · have ha : 0 < a := lt_of_le_of_ne ha0 (Ne.symm haz)
    have hv : variance c a ≠ 0 := by
      have hcpos : 0 < c := pos_iff_ne_zero.mpr hc
      have hapos : 0 < Real.toNNReal a := by
        rw [Real.toNNReal_of_nonneg ha0]
        exact NNReal.coe_pos.mpr ha
      exact (mul_pos (pow_pos hcpos 2) hapos).ne'
    have hpdfVar : variance c (a * (1 - a)) ≠ 0 := by
      have hprod : 0 < a * (1 - a) := mul_pos ha (by linarith)
      have hcpos : 0 < c := pos_iff_ne_zero.mpr hc
      have hval : 0 < Real.toNNReal (a * (1 - a)) := by
        rw [Real.toNNReal_of_nonneg hprod.le]
        exact NNReal.coe_pos.mpr hprod
      exact (mul_pos (pow_pos hcpos 2) hval).ne'
    have hvar1 : variance c 1 ≠ 0 := by
      have hcpos : 0 < c := pos_iff_ne_zero.mpr hc
      exact (mul_pos (pow_pos hcpos 2) (by norm_num : 0 < Real.toNNReal (1 : ℝ))).ne'
    have hweight_nonneg (x : ℝ) : 0 ≤ prefixDensity c a x := by
      unfold prefixDensity
      exact div_nonneg (gaussianPDFReal_nonneg _ _ _) (le_of_lt (gaussianPDFReal_pos _ _ _ hvar1))
    rw [gaussianReal_of_var_ne_zero _ hv]
    rw [lintegral_withDensity_eq_lintegral_mul₀
      (measurable_gaussianPDF _ _).aemeasurable hweight.aemeasurable]
    have hprod : ∀ x : ℝ,
        gaussianPDFReal 0 (variance c a) x * prefixDensity c a x =
          gaussianPDFReal 0 (variance c (a * (1 - a))) x :=
      gaussianPDFReal_mul_prefixDensity hc ha ha1
    calc
      ∫⁻ x, gaussianPDF 0 (variance c a) x * ENNReal.ofReal (prefixDensity c a x)
          ∂volume = ∫⁻ x, ENNReal.ofReal (gaussianPDFReal 0
            (variance c (a * (1 - a))) x) ∂volume := by
        apply lintegral_congr_ae
        filter_upwards [] with x
        rw [gaussianPDF, ← ENNReal.ofReal_mul (gaussianPDFReal_nonneg _ _ _), hprod x]
      _ = 1 := lintegral_gaussianPDFReal_eq_one 0 hpdfVar

/-- **Bridge prefix density.** For `0 ≤ a < 1`, the law of the bridge restricted to `[0,a]`
is absolutely continuous with respect to Brownian motion on `[0,a]`, with density
`p_{c²(1-a)}(-X_a) / p_{c²}(0)`. -/
theorem map_restrict_bridgeD_eq_withDensity {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha0 : 0 ≤ a)
    (ha1 : a < 1) :
    (bridgeD c : Measure (D 1 ℝ)).map (restrict (E := ℝ) ha1.le) =
      (wienerD c a : Measure (D a ℝ)).withDensity
        (fun f => ENNReal.ofReal (prefixDensity c a (f ⟨a, ha0, le_rfl⟩))) := by
  classical
  let e₀ : Set.Icc (0 : ℝ) a := ⟨a, ha0, le_rfl⟩
  let w : ℝ → ℝ≥0∞ := fun x => ENNReal.ofReal (prefixDensity c a x)
  let wPath : D a ℝ → ℝ≥0∞ := fun f => w (f e₀)
  have hw : Measurable w := by
    change Measurable (fun x : ℝ => ENNReal.ofReal (prefixDensity c a x))
    fun_prop [prefixDensity]
  have hwPath : Measurable wPath := hw.comp (measurable_eval e₀)
  let Q : Measure (D a ℝ) := (wienerD c a : Measure (D a ℝ)).withDensity wPath
  have hQmass : Q Set.univ = 1 := by
    change ((wienerD c a : Measure (D a ℝ)).withDensity wPath) Set.univ = 1
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    exact lintegral_prefixDensity_wienerD hc ha0 ha1
  have hQprob : IsProbabilityMeasure Q := ⟨hQmass⟩
  let P : ProbabilityMeasure (D a ℝ) := (bridgeD c).map (restrict (E := ℝ) ha1.le)
  let Qpm : ProbabilityMeasure (D a ℝ) := ⟨Q, hQprob⟩
  have hPQ : P = Qpm := by
    apply BGW.Skorokhod.ext_of_finiteDimensional (S := Set.univ) dense_univ ha0 (by simp)
    intro s hs
    apply ProbabilityMeasure.toMeasure_injective
    by_cases haz : a = 0
    · subst a
      let z₀ : Set.Icc (0 : ℝ) 0 := ⟨0, le_rfl, le_rfl⟩
      let z₁ : Set.Icc (0 : ℝ) 1 := ⟨0, le_rfl, by norm_num⟩
      let u : s → Set.Icc (0 : ℝ) 1 := fun t =>
        ⟨t.val, t.val.property.1, t.val.property.2.trans (by norm_num)⟩
      let evalB : D 1 ℝ → s → ℝ := fun f t => f (u t)
      let evalW : D 0 ℝ → s → ℝ := fun f t => f t.val
      have hevalB : Measurable evalB := Measurable.of_eval fun t => measurable_eval (u t)
      have hevalW : Measurable evalW := Measurable.of_eval fun t => measurable_eval t.val
      have haeB : ∀ᵐ f ∂(bridgeD c : Measure (D 1 ℝ)), evalB f = fun _ => 0 := by
        filter_upwards [ae_endpoints_bridgeD c] with f hf
        funext t
        have ht : u t = z₁ := by
          apply Subtype.ext
          have hmem := t.val.property
          exact le_antisymm hmem.2 hmem.1
        simpa [evalB, ht, z₁] using hf.1
      have hac : Q ≪ (wienerD c 0 : Measure (D 0 ℝ)) :=
        MeasureTheory.withDensity_absolutelyContinuous _ _
      have haeW : ∀ᵐ f ∂Q, evalW f = fun _ => 0 := by
        filter_upwards [hac.ae_le (ae_eval_zero_wienerD c le_rfl)] with f hf
        funext t
        have ht : t.val = z₀ := by
          apply Subtype.ext
          have hmem := t.val.property
          exact le_antisymm hmem.2 hmem.1
        change f t.val = 0
        rw [ht]
        simpa [z₀] using hf
      have hmapB : Measure.map evalB (bridgeD c : Measure (D 1 ℝ)) =
          Measure.dirac (fun _ => 0) := by
        rw [Measure.map_congr haeB, Measure.map_const, measure_univ, one_smul]
      have hmapW : Measure.map evalW Q = Measure.dirac (fun _ => 0) := by
        rw [Measure.map_congr haeW, Measure.map_const, hQmass, one_smul]
      simp only [ProbabilityMeasure.toMeasure_map, P, Qpm]
      change Measure.map evalW
          (Measure.map (restrict (T := 1) (a := 0) (by norm_num))
            (bridgeD c : Measure (D 1 ℝ))) = Measure.map evalW Q
      have hleft : Measure.map evalW
          (Measure.map (restrict (T := 1) (a := 0) (E := ℝ) (by norm_num))
            (bridgeD c : Measure (D 1 ℝ))) =
          Measure.map evalB (bridgeD c : Measure (D 1 ℝ)) := by
        rw [Measure.map_map hevalW
          (measurable_restrict (T := 1) (a := 0) (by norm_num))]
        congr 1
      rw [hleft, hmapB, hmapW]
    · have ha : 0 < a := lt_of_le_of_ne ha0 (Ne.symm haz)
      let e₁ : Set.Icc (0 : ℝ) 1 := ⟨a, ha.le, ha1.le⟩
      let u : s → Set.Icc (0 : ℝ) 1 := fun t =>
        ⟨t.val, t.val.property.1, t.val.property.2.trans ha1.le⟩
      let Rw : D a ℝ → s → ℝ := fun f t => f t.val - ((t.val : ℝ) / a) * f e₀
      let Xw : D a ℝ → ℝ := fun f => f e₀
      let Rb : D 1 ℝ → s → ℝ := fun f t => f (u t) - ((t.val : ℝ) / a) * f e₁
      let Xb : D 1 ℝ → ℝ := fun f => f e₁
      let pairW : D a ℝ → (s → ℝ) × ℝ := fun f => (Rw f, Xw f)
      let pairB : D 1 ℝ → (s → ℝ) × ℝ := fun f => (Rb f, Xb f)
      let combine : (s → ℝ) × ℝ → s → ℝ := fun p t => p.1 t + ((t.val : ℝ) / a) * p.2
      let evalW : D a ℝ → s → ℝ := fun f t => f t.val
      let evalB : D 1 ℝ → s → ℝ := fun f t => f (u t)
      have hRw : Measurable Rw := Measurable.of_eval fun t =>
        (measurable_eval t.val).sub ((measurable_eval e₀).const_mul ((t.val : ℝ) / a))
      have hXw : Measurable Xw := measurable_eval e₀
      have hRb : Measurable Rb := Measurable.of_eval fun t =>
        (measurable_eval (u t)).sub ((measurable_eval e₁).const_mul ((t.val : ℝ) / a))
      have hXb : Measurable Xb := measurable_eval e₁
      have hpairW : Measurable pairW := hRw.prodMk hXw
      have hpairB : Measurable pairB := hRb.prodMk hXb
      have hindW : IndepFun Rw Xw (wienerD c a : Measure (D a ℝ)) := by
        simpa [Rw, Xw, e₀] using indepFun_wienerResidual_endpoint (c := c) ha s
      have hindB : IndepFun Rb Xb (bridgeD c : Measure (D 1 ℝ)) := by
        simpa [Rb, Xb, e₁, u] using indepFun_bridgeResidual_endpoint (c := c) ha ha1 s
      have hpairWlaw := map_withDensity_pair_indep Rw Xw hRw hXw hindW w hw
      have hpairBlaw : Measure.map pairB (bridgeD c : Measure (D 1 ℝ)) =
          (Measure.map Rb (bridgeD c : Measure (D 1 ℝ))).prod
            (Measure.map Xb (bridgeD c : Measure (D 1 ℝ))) :=
        hindB.map_prod_eq_prod_map_map hRb.aemeasurable hXb.aemeasurable
      have hres := map_wienerResidual_eq_bridgeResidual (c := c) ha ha1 s
      have hvarB : variance c (a * (1 - a)) =
          c ^ 2 * ⟨a * (1 - a), mul_nonneg ha.le (sub_nonneg.mpr ha1.le)⟩ := by
        apply NNReal.coe_injective
        change (c : ℝ) ^ 2 * (Real.toNNReal (a * (1 - a)) : ℝ) =
          (c : ℝ) ^ 2 * (a * (1 - a))
        rw [Real.coe_toNNReal _ (mul_nonneg ha.le (sub_nonneg.mpr ha1.le))]
      have hmapXb : Measure.map Xb (bridgeD c : Measure (D 1 ℝ)) =
          gaussianReal 0 (variance c (a * (1 - a))) := by
        simpa [Xb, e₁, hvarB] using map_eval_bridgeD c e₁
      have hpairEq : Measure.map pairW Q = Measure.map pairB (bridgeD c : Measure (D 1 ℝ)) := by
        rw [hpairWlaw, hpairBlaw, hres, map_eval_wienerD c e₀, hmapXb,
          weighted_gaussian_endpoint hc ha ha1]
      have hcombine : Measurable combine := Measurable.of_eval fun t =>
        ((measurable_pi_apply t).comp measurable_fst).add
          (measurable_snd.const_mul ((t.val : ℝ) / a))
      have hevalW : Measurable evalW := Measurable.of_eval fun t => measurable_eval t.val
      have hevalB : Measurable evalB := Measurable.of_eval fun t => measurable_eval (u t)
      have hvalsW : evalW = combine ∘ pairW := by
        funext f t
        simp [evalW, combine, pairW, Rw, Xw]
      have hvalsB : evalB = combine ∘ pairB := by
        funext f t
        simp [evalB, combine, pairB, Rb, Xb]
      have hfd : Measure.map evalB (bridgeD c : Measure (D 1 ℝ)) = Measure.map evalW Q := by
        calc
          _ = Measure.map (combine ∘ pairB) (bridgeD c : Measure (D 1 ℝ)) := by rw [hvalsB]
          _ = Measure.map combine (Measure.map pairB (bridgeD c : Measure (D 1 ℝ))) :=
            (Measure.map_map hcombine hpairB).symm
          _ = Measure.map combine (Measure.map pairW Q) :=
            congrArg (Measure.map combine) hpairEq.symm
          _ = Measure.map (combine ∘ pairW) Q := Measure.map_map hcombine hpairW
          _ = Measure.map evalW Q := by rw [← hvalsW]
      simp only [ProbabilityMeasure.toMeasure_map, P, Qpm]
      change Measure.map evalW
          (Measure.map (restrict (T := 1) (a := a) ha1.le)
            (bridgeD c : Measure (D 1 ℝ))) = Measure.map evalW Q
      have hleft : Measure.map evalW
          (Measure.map (restrict (T := 1) (a := a) (E := ℝ) ha1.le)
            (bridgeD c : Measure (D 1 ℝ))) =
          Measure.map evalB (bridgeD c : Measure (D 1 ℝ)) := by
        rw [Measure.map_map hevalW
          (measurable_restrict (T := 1) (a := a) ha1.le)]
        congr 1
      rw [hleft, hfd]
  exact congrArg (fun R : ProbabilityMeasure (D a ℝ) => (R : Measure (D a ℝ))) hPQ

/-- Absolute continuity of the bridge prefix. -/
theorem map_restrict_bridgeD_absolutelyContinuous {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ}
    (ha0 : 0 ≤ a) (ha1 : a < 1) :
    (bridgeD c : Measure (D 1 ℝ)).map (restrict (E := ℝ) ha1.le) ≪
      (wienerD c a : Measure (D a ℝ)) := by
  rw [map_restrict_bridgeD_eq_withDensity hc ha0 ha1]
  exact MeasureTheory.withDensity_absolutelyContinuous _ _

end BGW.ContinuumTrees.BrownianD
