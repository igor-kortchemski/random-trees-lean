module

public import BGW.ContinuumTrees.BrownianBridgeIncrements
public import Mathlib.Probability.Distributions.Gaussian.IsGaussianProcess.Independence
import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.FunProp
import Mathlib.Tactic.Ring

/-!
# Regression on a Brownian bridge increment

Subtracting the covariance profile times one increment leaves zero covariance
with that increment at every time. The profile is explicit on the intervals
before and after the increment, which will separate their minimum values.
The normalized identities retain nondegeneracy of the increment. Joint
Gaussianity then proves independence of the continuous residual path and the
increment, using exactly the sigma-algebra generated by path evaluations.
Uniqueness of minima is a later probability result.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace BGW.ContinuumTrees.BrownianBridge

/-- Covariance with an increment, computed under the actual bridge law. -/
theorem covariance_eval_increment (s b c : unitInterval) :
    cov[fun f : C(unitInterval, ℝ) => f s, fun f => f c - f b;
      (law : Measure C(unitInterval, ℝ))] =
      min (s : ℝ) (c : ℝ) - min (s : ℝ) (b : ℝ) -
        (s : ℝ) * ((c : ℝ) - (b : ℝ)) := by
  have hmem (r : unitInterval) := (isGaussianProcess_eval.hasGaussianLaw_eval r).memLp_two
  rw [covariance_fun_sub_right (hmem s) (hmem c) (hmem b), covariance_eval, covariance_eval]
  ring

/-- The continuous covariance profile. Normalized regression is used only when
`0 < c - b < 1`; the formula itself is total at other parameters. -/
noncomputable def regressionProfile (b c : unitInterval) : C(unitInterval, ℝ) where
  toFun s := (min (s : ℝ) (c : ℝ) - min (s : ℝ) (b : ℝ) -
    (s : ℝ) * ((c : ℝ) - (b : ℝ))) /
      (((c : ℝ) - (b : ℝ)) * (1 - ((c : ℝ) - (b : ℝ))))
  continuous_toFun := by fun_prop

@[simp] theorem regressionProfile_apply (b c s : unitInterval) :
    regressionProfile b c s =
      (min (s : ℝ) (c : ℝ) - min (s : ℝ) (b : ℝ) -
        (s : ℝ) * ((c : ℝ) - (b : ℝ))) /
      (((c : ℝ) - (b : ℝ)) * (1 - ((c : ℝ) - (b : ℝ)))) := rfl

/-- Before the increment, the regression profile is nonpositive and linear in time. -/
theorem regressionProfile_of_le (b c s : unitInterval) (hbc : b < c)
    (hshort : (c : ℝ) - (b : ℝ) < 1) (hs : s ≤ b) :
    regressionProfile b c s = -(s : ℝ) / (1 - ((c : ℝ) - (b : ℝ))) := by
  have hbcR : (b : ℝ) < (c : ℝ) := hbc
  have hsR : (s : ℝ) ≤ (b : ℝ) := hs
  have hpos : 0 < (c : ℝ) - (b : ℝ) := sub_pos.mpr hbcR
  have hcomp : 0 < 1 - ((c : ℝ) - (b : ℝ)) := sub_pos.mpr hshort
  rw [regressionProfile_apply, min_eq_left (hsR.trans hbcR.le), min_eq_left hsR]
  field_simp
  ring

/-- After the increment, the profile is nonnegative and linear in the time remaining. -/
theorem regressionProfile_of_ge (b c s : unitInterval) (hbc : b < c)
    (hshort : (c : ℝ) - (b : ℝ) < 1) (hs : c ≤ s) :
    regressionProfile b c s = (1 - (s : ℝ)) / (1 - ((c : ℝ) - (b : ℝ))) := by
  have hbcR : (b : ℝ) < (c : ℝ) := hbc
  have hsR : (c : ℝ) ≤ (s : ℝ) := hs
  have hpos : 0 < (c : ℝ) - (b : ℝ) := sub_pos.mpr hbcR
  have hcomp : 0 < 1 - ((c : ℝ) - (b : ℝ)) := sub_pos.mpr hshort
  rw [regressionProfile_apply, min_eq_right hsR, min_eq_right (hbcR.le.trans hsR)]
  field_simp

/-- Remove the chosen increment times its covariance profile from a continuous path. -/
noncomputable def regressionResidual (b c : unitInterval) (f : C(unitInterval, ℝ)) :
    C(unitInterval, ℝ) := f - (f c - f b) • regressionProfile b c

theorem continuous_regressionResidual (b c : unitInterval) :
    Continuous (regressionResidual b c) := by
  unfold regressionResidual
  fun_prop

/-- The residual has zero covariance with the increment at each fixed time. -/
theorem covariance_regressionResidual_increment (b c s : unitInterval) (hbc : b < c)
    (hshort : (c : ℝ) - (b : ℝ) < 1) :
    cov[fun f : C(unitInterval, ℝ) => regressionResidual b c f s,
      fun f => f c - f b; (law : Measure C(unitInterval, ℝ))] = 0 := by
  have hmem := (isGaussianProcess_eval.hasGaussianLaw_eval s).memLp_two
  have hinc := (hasGaussianLaw_eval_sub c b).memLp_two
  have hcov := covariance_fun_sub_left hmem
    (hinc.const_mul (regressionProfile b c s)) hinc
  have hbcR : (b : ℝ) < (c : ℝ) := hbc
  have hpos : 0 < (c : ℝ) - (b : ℝ) := sub_pos.mpr hbcR
  have hcomp : 0 < 1 - ((c : ℝ) - (b : ℝ)) := sub_pos.mpr hshort
  have hden : ((c : ℝ) - (b : ℝ)) * (1 - ((c : ℝ) - (b : ℝ))) ≠ 0 :=
    (mul_pos hpos hcomp).ne'
  have heq : (fun f : C(unitInterval, ℝ) => regressionResidual b c f s) =
      (fun f => f s - regressionProfile b c s * (f c - f b)) := by
    funext f
    simp only [regressionResidual, ContinuousMap.sub_apply, ContinuousMap.smul_apply,
      smul_eq_mul, mul_comm]
  rw [heq, hcov, covariance_const_mul_left,
    covariance_self (by fun_prop), covariance_eval_increment, variance_eval_sub,
    abs_of_pos hpos, regressionProfile_apply, div_mul_cancel₀ _ hden, sub_self]

/-- The whole continuous residual path is independent of the chosen increment. -/
theorem indepFun_regressionResidual_increment (b c : unitInterval) (hbc : b < c)
    (hshort : (c : ℝ) - (b : ℝ) < 1) :
    IndepFun (regressionResidual b c) (fun f : C(unitInterval, ℝ) => f c - f b)
      (law : Measure C(unitInterval, ℝ)) := by
  have hjoint : IsGaussianProcess (Sum.elim
      (fun s (f : C(unitInterval, ℝ)) => regressionResidual b c f s)
      (fun (_ : Unit) (f : C(unitInterval, ℝ)) => f c - f b))
      (law : Measure C(unitInterval, ℝ)) := by
    apply isGaussianProcess_eval.of_isGaussianProcess
    intro q
    cases q with
    | inl s =>
      refine ⟨{s, b, c},
        { toFun := fun x => x ⟨s, by simp⟩ -
            (x ⟨c, by simp⟩ - x ⟨b, by simp⟩) * regressionProfile b c s
          map_add' := ?_
          map_smul' := ?_ }, ?_⟩
      · intro x y
        simp only [Pi.add_apply]
        ring
      · intro a x
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
        ring
      · intro f
        rfl
    | inr q =>
      refine ⟨{b, c},
        { toFun := fun x => x ⟨c, by simp⟩ - x ⟨b, by simp⟩
          map_add' := ?_
          map_smul' := ?_ }, ?_⟩
      · intro x y
        simp only [Pi.add_apply]
        ring
      · intro a x
        simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
        ring
      · intro f
        rfl
  have hmZ : Measurable (fun f : C(unitInterval, ℝ) => f c - f b) := by fun_prop
  have hpi := hjoint.indepFun_of_covariance_eq_zero
    (fun s => ((continuous_eval_const s).comp
      (continuous_regressionResidual b c)).measurable.aemeasurable)
    (fun _ => hmZ.aemeasurable)
    (fun s _ => covariance_regressionResidual_increment b c s hbc hshort)
  have hi : IndepFun (fun f : C(unitInterval, ℝ) => fun s => regressionResidual b c f s)
      (fun f : C(unitInterval, ℝ) => f c - f b)
      (law : Measure C(unitInterval, ℝ)) := by
    simpa only [Function.comp_def, id_eq] using hpi.comp measurable_id (measurable_pi_apply ())
  have hcomap : MeasurableSpace.comap (regressionResidual b c)
      (inferInstance : MeasurableSpace C(unitInterval, ℝ)) =
      MeasurableSpace.comap (fun f : C(unitInterval, ℝ) => fun s =>
        regressionResidual b c f s) inferInstance := by
    rw [ContinuousMap.measurableSpace_eq_iSup_comap_eval, MeasurableSpace.comap_iSup,
      MeasurableSpace.comap_process_pi]
    simp only [MeasurableSpace.comap_comp, Function.comp_def]
  unfold IndepFun Kernel.IndepFun at hi ⊢
  rw [hcomap]
  exact hi

end BGW.ContinuumTrees.BrownianBridge
