module

public import BGW.Skorokhod.MeasurableMaps

/-!
# Increment paths and the natural past

This file defines the path of increments after a deterministic time, proves its Borel
measurability, and identifies the σ-algebra of a restricted path with the σ-algebra generated by
its evaluations, the setting of the simple Markov property (J. Bertoin, *Lévy Processes*,
Cambridge University Press, 1996, Chapter I).
-/

@[expose] public section

open MeasureTheory
open scoped Topology

namespace BGW.Skorokhod

/-- The increment path after the deterministic time `s`: `t ↦ f (s + t) - f s` on `[0, T - s]`. -/
noncomputable def shiftIncrement {T s : ℝ} (hs : 0 ≤ s) (hsT : s ≤ T) (f : D T ℝ) :
    D (T - s) ℝ where
  toFun t := f ⟨s + t, add_nonneg hs t.2.1, by linarith [t.2.2]⟩ - f ⟨s, hs, hsT⟩
  isCadlag' := by
    let inc : Set.Icc (0 : ℝ) (T - s) → Set.Icc (0 : ℝ) T := fun t =>
      ⟨s + t, add_nonneg hs t.2.1, by linarith [t.2.2]⟩
    have hinc : Continuous inc :=
      Continuous.subtype_mk (continuous_const.add continuous_subtype_val) _
    have hcad : IsCadlag (f ∘ inc) := by
      constructor
      · intro x
        have hmap : Set.MapsTo inc (Set.Ioi x) (Set.Ioi (inc x)) := by
          intro y hy
          change (y : ℝ) > (x : ℝ) at hy
          change s + (y : ℝ) > s + (x : ℝ)
          linarith
        exact (isCadlag f).isRightContinuous (inc x) |>.comp
          (hinc.continuousAt.continuousWithinAt) hmap
      · intro x
        obtain ⟨l, hl⟩ := (isCadlag f).tendsto_nhdsLT (inc x)
        have hmem : ∀ᶠ y in nhdsWithin x (Set.Iio x), inc y ∈ Set.Iio (inc x) := by
          filter_upwards [self_mem_nhdsWithin] with y hy
          change (y : ℝ) < (x : ℝ) at hy
          change s + (y : ℝ) < s + (x : ℝ)
          linarith
        have hincLeft : Filter.Tendsto inc (nhdsWithin x (Set.Iio x))
            (nhdsWithin (inc x) (Set.Iio (inc x))) :=
          tendsto_nhdsWithin_iff.mpr
            ⟨tendsto_nhdsWithin_of_tendsto_nhds hinc.continuousAt, hmem⟩
        exact ⟨l, hl.comp hincLeft⟩
    exact hcad.continuous_comp (g := fun y : ℝ => y - f ⟨s, hs, hsT⟩) (by fun_prop)

/-- `shiftIncrement` is Borel measurable. -/
theorem measurable_shiftIncrement {T s : ℝ} (hs : 0 ≤ s) (hsT : s ≤ T) :
    Measurable (shiftIncrement hs hsT) := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap (shiftIncrement hs hsT)
      (inferInstance : MeasurableSpace (D (T - s) ℝ)) ≤
    (inferInstance : MeasurableSpace (D T ℝ))
  rw [measurableSpace_eq_iSup_comap_eval (T := T - s) (E := ℝ) (S := Set.univ)
    dense_univ (sub_nonneg.mpr hsT) (by simp)]
  simp only [MeasurableSpace.comap_iSup, iSup_le_iff, MeasurableSpace.comap_comp,
    Function.comp_def]
  intro t ht
  have hs0 : 0 ≤ s + (t : ℝ) := add_nonneg hs t.property.1
  have hsT' : s + (t : ℝ) ≤ T := by linarith [t.property.2]
  have hdiff : Measurable (fun f : D T ℝ =>
      f ⟨s + (t : ℝ), hs0, hsT'⟩ - f ⟨s, hs, hsT⟩) :=
    (measurable_eval _).sub (measurable_eval _)
  simpa only [shiftIncrement, coe_mk] using hdiff.comap_le

/-- Natural-past identification: the σ-algebra pulled back by `restrict hsT` is the σ-algebra
generated by the evaluations at times `≤ s` (both sides are σ-algebras on `D T ℝ`). -/
theorem comap_restrict_eq_iSup_comap_eval {T s : ℝ} (hsT : s ≤ T) :
    MeasurableSpace.comap (restrict (E := ℝ) hsT) (inferInstance : MeasurableSpace (D s ℝ)) =
      ⨆ t : {t : Set.Icc (0 : ℝ) T // (t : ℝ) ≤ s},
        MeasurableSpace.comap (fun f : D T ℝ => f t.1) (inferInstance : MeasurableSpace ℝ) := by
  by_cases hs : 0 ≤ s
  · rw [measurableSpace_eq_iSup_comap_eval (T := s) (E := ℝ) (S := Set.univ)
      dense_univ hs (by simp)]
    simp only [MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp, Function.comp_def,
      Set.mem_univ, iSup_true]
    apply le_antisymm
    · apply iSup_le
      intro t
      let u : {t : Set.Icc (0 : ℝ) T // (t : ℝ) ≤ s} :=
        ⟨⟨t, t.property.1, t.property.2.trans hsT⟩, t.property.2⟩
      apply le_iSup_of_le u
      exact le_of_eq (by rfl)
    · apply iSup_le
      intro t
      let u : Set.Icc (0 : ℝ) s := ⟨t.1, t.1.property.1, t.2⟩
      apply le_iSup_of_le u
      exact le_of_eq (by rfl)
  · have hs' : s < 0 := lt_of_not_ge hs
    let : Subsingleton (D s ℝ) := ⟨fun f g => ext fun t =>
      (not_le_of_gt hs' (t.property.1.trans t.property.2)).elim⟩
    let : IsEmpty {t : Set.Icc (0 : ℝ) T // (t : ℝ) ≤ s} :=
      ⟨fun t => not_le_of_gt hs' (t.1.property.1.trans t.2)⟩
    let c : D s ℝ := ⟨fun t => False.elim
      (not_le_of_gt hs' (t.property.1.trans t.property.2)), by
        constructor
        · intro t
          exact (not_le_of_gt hs' (t.property.1.trans t.property.2)).elim
        · intro t
          exact (not_le_of_gt hs' (t.property.1.trans t.property.2)).elim⟩
    have hconst : restrict (E := ℝ) hsT = fun _ => c := by
      funext f
      exact Subsingleton.elim _ _
    rw [hconst, MeasurableSpace.comap_const, iSup_of_empty]

end BGW.Skorokhod
