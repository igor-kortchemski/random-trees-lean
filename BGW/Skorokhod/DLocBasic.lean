/-!
# Basic API for the local càdlàg path space

The space `DLoc` consists of real càdlàg paths on nonnegative time. It carries the σ-algebra
generated by evaluations, together with restriction, shifting, natural filtrations, and strict
passage times. This module is independent of path-law constructions and Kolmogorov extension.

## References

* P. Billingsley, *Convergence of Probability Measures*, 2nd ed., Wiley, 1999,
  Section 16.
* D. Revuz and M. Yor, *Continuous Martingales and Brownian Motion*, 3rd ed., Springer, 1999,
  Chapter I, Section 4.
-/

@[expose] public section

open MeasureTheory Set Filter Topology MeasureTheory.Filtration
open scoped NNReal

namespace BGW.Skorokhod

/-- The integer horizons `n + 1` are positive and strictly increasing. -/
theorem strictMono_succHorizon : StrictMono (fun n : ℕ => (n : ℝ) + 1) := by
  intro m n h; simpa using h

/-- The local càdlàg carrier: càdlàg real paths on `ℝ≥0` (Mathlib's `IsCadlag`; at `0` the
left limit is vacuous). -/
def DLoc : Type := {f : ℝ≥0 → ℝ // IsCadlag f}

namespace DLoc

/-- Evaluation at time `t`. -/
def eval (t : ℝ≥0) (f : DLoc) : ℝ := f.1 t

/-- The evaluation σ-algebra: the supremum of the pullbacks of the Borel σ-algebra of `ℝ` under
all evaluations. -/
noncomputable instance : MeasurableSpace DLoc :=
  ⨆ t : ℝ≥0, MeasurableSpace.comap (eval t) inferInstance

/-- Restriction to `[0, T]`, as an element of the compact path space. -/
def restrict (T : ℝ≥0) (f : DLoc) : D (T : ℝ) ℝ where
  toFun t := f.1 ⟨t.1, t.2.1⟩
  isCadlag' := by
    let inc : Set.Icc (0 : ℝ) (T : ℝ) → ℝ≥0 := fun t => ⟨t, t.2.1⟩
    have hinc : Continuous inc :=
      Continuous.subtype_mk continuous_subtype_val fun t => t.2.1
    constructor
    · intro t
      have hmap : MapsTo inc (Set.Ioi t) (Set.Ioi (inc t)) := by
        intro u hu
        change (u : ℝ) > (t : ℝ) at hu ⊢
        exact hu
      exact f.2.isRightContinuous (inc t) |>.comp
        hinc.continuousAt.continuousWithinAt hmap
    · intro t
      obtain ⟨l, hl⟩ := f.2.tendsto_nhdsLT (inc t)
      have hmem : ∀ᶠ u in 𝓝[Set.Iio t] t, inc u ∈ Set.Iio (inc t) := by
        filter_upwards [self_mem_nhdsWithin] with u hu
        change (u : ℝ) < (t : ℝ) at hu ⊢
        exact hu
      have hincLeft : Tendsto inc (𝓝[Set.Iio t] t) (𝓝[Set.Iio (inc t)] (inc t)) :=
        tendsto_nhdsWithin_iff.mpr
          ⟨tendsto_nhdsWithin_of_tendsto_nhds hinc.continuousAt, hmem⟩
      exact ⟨l, hl.comp hincLeft⟩

/-- Centered shift: `u ↦ f (s + u) - f s`. -/
def shift (s : ℝ≥0) (f : DLoc) : DLoc :=
  ⟨fun u => f.1 (s + u) - f.1 s, by
    have htrans : IsCadlag (fun u : ℝ≥0 => f.1 (s + u)) := by
      constructor
      · intro u
        have hmap : MapsTo (fun v : ℝ≥0 => s + v) (Set.Ioi u) (Set.Ioi (s + u)) := by
          intro v hv
          change u < v at hv
          change (s + u : ℝ≥0) < s + v
          simpa only [add_lt_add_iff_left] using hv
        exact f.2.isRightContinuous (s + u) |>.comp
          (continuous_const.add continuous_id).continuousAt.continuousWithinAt hmap
      · intro u
        obtain ⟨l, hl⟩ := f.2.tendsto_nhdsLT (s + u)
        have hmem : ∀ᶠ v in 𝓝[Set.Iio u] u, s + v ∈ Set.Iio (s + u) := by
          filter_upwards [self_mem_nhdsWithin] with v hv
          change v < u at hv
          change (s + v : ℝ≥0) < s + u
          simpa only [add_lt_add_iff_left] using hv
        have hleft : Tendsto (fun v : ℝ≥0 => s + v) (𝓝[Set.Iio u] u)
            (𝓝[Set.Iio (s + u)] (s + u)) :=
          tendsto_nhdsWithin_iff.mpr
            ⟨tendsto_nhdsWithin_of_tendsto_nhds
              ((continuous_const.add continuous_id).continuousAt), hmem⟩
        exact ⟨l, hl.comp hleft⟩
    exact htrans.sub IsCadlag.const⟩

/-- Evaluation is measurable. -/
theorem measurable_eval (t : ℝ≥0) : Measurable (eval t) := by
  rw [measurable_iff_comap_le]
  exact le_iSup_of_le t le_rfl

/-- Restriction to every compact horizon is measurable. -/
theorem measurable_restrict (T : ℝ≥0) : Measurable (restrict T) := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap (restrict T)
      (inferInstance : MeasurableSpace (D (T : ℝ) ℝ)) ≤ _
  rw [measurableSpace_eq_iSup_comap_eval (T := (T : ℝ)) (E := ℝ) (S := Set.univ)
    dense_univ T.2 (by simp)]
  simp only [MeasurableSpace.comap_iSup, iSup_le_iff, MeasurableSpace.comap_comp,
    Function.comp_def]
  intro t _
  exact (measurable_eval ⟨t, t.2.1⟩).comap_le

/-- The evaluation σ-algebra is generated by restrictions to integer horizons. -/
theorem measurableSpace_eq_iSup_comap_restrict :
    (inferInstance : MeasurableSpace DLoc) =
      ⨆ n : ℕ, MeasurableSpace.comap (restrict (n : ℝ≥0)) inferInstance := by
  apply le_antisymm
  · change (⨆ t : ℝ≥0, MeasurableSpace.comap (eval t) inferInstance) ≤ _
    apply iSup_le
    intro t
    let n : ℕ := ⌈(t : ℝ)⌉₊
    have htn : (t : ℝ) ≤ (n : ℝ) := by
      dsimp [n]
      exact Nat.le_ceil _
    let N : ℝ≥0 := n
    have htN : (t : ℝ) ≤ (N : ℝ) := by simpa [N] using htn
    let t' : Set.Icc (0 : ℝ) (N : ℝ) := ⟨t, t.2, htN⟩
    have heval : (eval t) =
        (fun g : D (N : ℝ) ℝ => g t') ∘ restrict N := by
      funext f
      rfl
    rw [heval, ← MeasurableSpace.comap_comp]
    apply le_iSup_of_le n
    exact MeasurableSpace.comap_mono (BGW.Skorokhod.measurable_eval t').comap_le
  · apply iSup_le
    intro n
    exact (measurable_restrict (n : ℝ≥0)).comap_le

private theorem measurable_eval_on_bounded_horizon (n : ℕ) :
    Measurable (fun p : DLoc × ℝ≥0 => p.1.1 (min p.2 (n : ℝ≥0))) := by
  let T : ℝ := n
  let τ : ℝ≥0 → Set.Icc (0 : ℝ) T := fun t =>
    ⟨min (t : ℝ) T,
      le_min (show (0 : ℝ) ≤ (t : ℝ) from t.2) (by positivity), min_le_right _ _⟩
  have hτ : Measurable τ := by
    have hτc : Continuous τ :=
      Continuous.subtype_mk (continuous_subtype_val.min continuous_const) fun t =>
        ⟨le_min t.2 (by positivity), min_le_right _ _⟩
    exact hτc.measurable
  let hEval : ∀ t : Set.Icc (0 : ℝ) T,
      Measurable (fun f : D T ℝ => f t) := fun t => BGW.Skorokhod.measurable_eval t
  have heval₂ := measurable_eval₂_of_measurable_eval hEval
  have hpair : Measurable (fun p : DLoc × ℝ≥0 =>
      (restrict ⟨T, by positivity⟩ p.1, τ p.2)) :=
    (measurable_restrict ⟨T, by positivity⟩).comp measurable_fst |>.prodMk
      (hτ.comp measurable_snd)
  have hfactor : (fun p : DLoc × ℝ≥0 => p.1.1 (min p.2 (n : ℝ≥0))) =
      (fun q : D T ℝ × Set.Icc (0 : ℝ) T => q.1 q.2) ∘
        (fun p : DLoc × ℝ≥0 => (restrict ⟨T, by positivity⟩ p.1, τ p.2)) := by
    funext p
    rfl
  rw [hfactor]
  exact heval₂.comp hpair

/-- Joint measurability of `(f, t) ↦ f t`. -/
theorem measurable_eval₂ : Measurable (fun p : DLoc × ℝ≥0 => p.1.1 p.2) := by
  intro s hs
  have hpre : {p : DLoc × ℝ≥0 | p.1.1 p.2 ∈ s} =
      ⋃ n : ℕ, {p | p.2 ≤ (n : ℝ≥0)} ∩
        {p | p.1.1 (min p.2 (n : ℝ≥0)) ∈ s} := by
    ext p
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff]
    constructor
    · intro hp
      let n : ℕ := ⌈(p.2 : ℝ)⌉₊
      have htn : (p.2 : ℝ) ≤ (n : ℝ) := by
        dsimp [n]
        exact Nat.le_ceil _
      have htn' : p.2 ≤ (n : ℝ≥0) := by exact_mod_cast htn
      refine ⟨n, htn', ?_⟩
      simpa [min_eq_left htn'] using hp
    · intro hpAll
      rcases hpAll with ⟨n, htn, hp⟩
      simpa [min_eq_left htn] using hp
  change MeasurableSet {p : DLoc × ℝ≥0 | p.1.1 p.2 ∈ s}
  rw [hpre]
  apply MeasurableSet.iUnion
  intro (n : ℕ)
  apply MeasurableSet.inter
  · exact measurable_snd (measurableSet_Iic : MeasurableSet (Set.Iic (n : ℝ≥0)))
  · exact (measurable_eval_on_bounded_horizon n) hs

/-- Joint measurability of the centered shift `(s, f) ↦ shift s f`. -/
theorem measurable_shift : Measurable (fun p : ℝ≥0 × DLoc => shift p.1 p.2) := by
  rw [measurable_iff_comap_le]
  change (⨆ t : ℝ≥0, MeasurableSpace.comap (eval t) inferInstance).comap
      (fun p : ℝ≥0 × DLoc => shift p.1 p.2) ≤ _
  rw [MeasurableSpace.comap_iSup, iSup_le_iff]
  intro t
  have hplus : Measurable (fun p : ℝ≥0 × DLoc => (p.2, p.1 + t)) :=
    measurable_snd.prodMk ((measurable_fst.add_const t))
  have hbase : Measurable (fun p : ℝ≥0 × DLoc => (p.2, p.1)) :=
    measurable_snd.prodMk measurable_fst
  have hcoord : Measurable (fun p : ℝ≥0 × DLoc =>
      (shift p.1 p.2).1 t) := by
    change Measurable (fun p : ℝ≥0 × DLoc => p.2.1 (p.1 + t) - p.2.1 p.1)
    exact (measurable_eval₂.comp hplus).sub (measurable_eval₂.comp hbase)
  rw [MeasurableSpace.comap_comp]
  change MeasurableSpace.comap
      (fun p : ℝ≥0 × DLoc => eval t (shift p.1 p.2)) inferInstance ≤ _
  have hcoord' : Measurable (fun p : ℝ≥0 × DLoc => eval t (shift p.1 p.2)) := by
    simpa [eval, shift] using hcoord
  exact hcoord'.comap_le

/-- The shift is a semigroup action: `shift s (shift t f) = shift (t + s) f`. -/
theorem shift_shift (s t : ℝ≥0) (f : DLoc) : shift s (shift t f) = shift (t + s) f := by
  apply Subtype.ext
  funext u
  simp only [shift]
  simp only [add_assoc]
  ring

/-- Restrictions are compatible with each other. -/
theorem restrict_restrict {a T : ℝ≥0} (h : a ≤ T) (f : DLoc) :
    BGW.Skorokhod.restrict (show (a : ℝ) ≤ T from h) (restrict T f) = restrict a f := by
  ext t
  rfl

/-- Extensionality by restrictions to the integer horizons. -/
theorem ext_of_restrict {f g : DLoc}
    (h : ∀ n : ℕ, restrict (n : ℝ≥0) f = restrict (n : ℝ≥0) g) : f = g := by
  apply Subtype.ext
  funext t
  let n : ℕ := ⌈(t : ℝ)⌉₊
  have ht : (t : ℝ) ≤ (n : ℝ) := by
    dsimp [n]
    exact Nat.le_ceil _
  have hn := congrArg (fun q : D (n : ℝ) ℝ => q ⟨t, t.2, ht⟩) (h n)
  exact hn

/-! ### Filtrations -/

/-- The natural (raw) filtration `F_t = σ(f s : s ≤ t)`. It does not depend on any law. -/
noncomputable def rawFiltration : Filtration ℝ≥0 (inferInstance : MeasurableSpace DLoc) where
  seq t := ⨆ s ≤ t, MeasurableSpace.comap (eval s) inferInstance
  mono' _ _ hst := biSup_mono fun _ hs => hs.trans hst
  le' _ := iSup₂_le fun s _ =>
    le_iSup (fun r : ℝ≥0 => MeasurableSpace.comap (eval r) inferInstance) s

/-- The right-continuous filtration `F⁺_t = ⋂_{u > t} F_u` (Mathlib's `rightCont`). -/
noncomputable def filtration : Filtration ℝ≥0 (inferInstance : MeasurableSpace DLoc) :=
  rawFiltration.rightCont

/-- The filtration `filtration` is right-continuous. -/
instance : DLoc.filtration.IsRightContinuous :=
  inferInstanceAs rawFiltration.rightCont.IsRightContinuous

private theorem measurable_eval_rawFiltration {s t : ℝ≥0} (hst : s ≤ t) :
    Measurable[rawFiltration t] (eval s) := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap (eval s) inferInstance ≤
    ⨆ r ≤ t, MeasurableSpace.comap (eval r) inferInstance
  exact le_iSup_of_le s (le_iSup_of_le hst le_rfl)

private theorem measurable_restrict_rawFiltration (T : ℝ≥0) :
    Measurable[rawFiltration T] (restrict T) := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap (restrict T)
      (inferInstance : MeasurableSpace (D (T : ℝ) ℝ)) ≤ rawFiltration T
  rw [BGW.Skorokhod.measurableSpace_eq_iSup_comap_eval (T := (T : ℝ)) (E := ℝ)
    (S := Set.univ) dense_univ T.2 (by simp)]
  simp only [MeasurableSpace.comap_iSup, iSup_le_iff, MeasurableSpace.comap_comp,
    Function.comp_def]
  intro t ht
  let s : ℝ≥0 := ⟨t, t.2.1⟩
  have hst : s ≤ T := by exact_mod_cast t.2.2
  exact (measurable_eval_rawFiltration hst).comap_le

/-- The σ-algebra of `DLoc` is the supremum of the raw filtration. -/
theorem iSup_rawFiltration :
    ⨆ t, rawFiltration t = (inferInstance : MeasurableSpace DLoc) := by
  apply le_antisymm
  · apply iSup_le
    intro t
    change (⨆ s ≤ t, MeasurableSpace.comap (eval s) inferInstance) ≤ _
    apply iSup₂_le
    intro s hs
    exact le_iSup_of_le s le_rfl
  · change (⨆ s : ℝ≥0, MeasurableSpace.comap (eval s) inferInstance) ≤ _
    apply iSup_le
    intro s
    exact le_iSup_of_le s (le_iSup_of_le s (le_iSup_of_le le_rfl le_rfl))

/-- The coordinate process is adapted to the raw filtration, hence to `filtration`. -/
theorem adapted_eval : Adapted filtration (fun t (f : DLoc) => f.1 t) := by
  intro t
  exact (measurable_eval_rawFiltration (show t ≤ t from le_rfl)).mono
    (rawFiltration.le_rightCont t) le_rfl

private theorem measurable_eval₂_on_rawFiltration (T : ℝ≥0) :
    Measurable[Subtype.instMeasurableSpace.prod (rawFiltration T)]
      (fun p : Set.Iic (T : ℝ≥0) × DLoc => p.2.1 p.1) := by
  let τ : Set.Iic (T : ℝ≥0) → Set.Icc (0 : ℝ) (T : ℝ) := fun t =>
    ⟨(t.1 : ℝ), t.1.2, by exact_mod_cast t.2⟩
  have hτ : Measurable τ := by
    apply Measurable.subtype_mk
    exact measurable_subtype_coe.comp measurable_subtype_coe
  have hpair : Measurable[Subtype.instMeasurableSpace.prod (rawFiltration T)]
      (fun p : Set.Iic (T : ℝ≥0) × DLoc => (restrict T p.2, τ p.1)) := by
    exact (measurable_restrict_rawFiltration T).comp measurable_snd |>.prodMk
      (hτ.comp measurable_fst)
  have heval : Measurable
      (fun q : D (T : ℝ) ℝ × Set.Icc (0 : ℝ) (T : ℝ) => q.1 q.2) :=
    BGW.Skorokhod.measurable_eval₂
  have hcomp := heval.comp hpair
  have hEq : (fun q : D (T : ℝ) ℝ × Set.Icc (0 : ℝ) (T : ℝ) => q.1 q.2) ∘
      (fun p : Set.Iic (T : ℝ≥0) × DLoc => (restrict T p.2, τ p.1)) =
      fun p => p.2.1 p.1 := by
    funext p
    rfl
  rw [hEq] at hcomp
  exact hcomp

/-- Càdlàg coordinate process is progressively measurable. -/
theorem isStronglyProgressive_eval :
    IsStronglyProgressive filtration (fun t (f : DLoc) => f.1 t) := by
  apply IsProgressive.isStronglyProgressive
  intro T
  let mIic : MeasurableSpace (Set.Iic (T : ℝ≥0)) := inferInstance
  have hprod : mIic.prod (rawFiltration T) ≤ mIic.prod (filtration T) := by
    rw [MeasurableSpace.prod, MeasurableSpace.prod]
    exact sup_le le_sup_left
      ((MeasurableSpace.comap_mono (rawFiltration.le_rightCont T)).trans le_sup_right)
  exact (measurable_eval₂_on_rawFiltration T).mono hprod le_rfl

/-! ### Strict passage times -/

/-- `T_x = inf {t | f t > x}` (strict passage upward); `⊤` if the set is empty. -/
noncomputable def strictPassageAbove (x : ℝ) (f : DLoc) : WithTop ℝ≥0 :=
  ⨅ (t : ℝ≥0) (_ : x < f.1 t), (t : WithTop ℝ≥0)

/-- `inf {t | f t < x}` (strict passage downward). -/
noncomputable def strictPassageBelow (x : ℝ) (f : DLoc) : WithTop ℝ≥0 :=
  ⨅ (t : ℝ≥0) (_ : f.1 t < x), (t : WithTop ℝ≥0)

private theorem exists_rational_time_above (x : ℝ) (f : DLoc) {s t : ℝ≥0}
    (hst : s < t) (hxs : x < f.1 s) :
    ∃ q : ℚ, 0 ≤ q ∧ (q : ℝ) < t ∧ x < f.1 (Real.toNNReal q) := by
  have hEventually : ∀ᶠ u in 𝓝[Set.Ioi s] s, x < f.1 u :=
    (f.2.isRightContinuous s).eventually (isOpen_Ioi.mem_nhds hxs)
  have hSet : {u : ℝ≥0 | x < f.1 u} ∈ 𝓝[Set.Ioi s] s := hEventually
  obtain ⟨b, hsb, hb⟩ := (nhdsGT_basis s).mem_iff.mp hSet
  have hstR : (s : ℝ) < (t : ℝ) := by exact_mod_cast hst
  have hs0 : (0 : ℝ) ≤ (s : ℝ) := s.2
  have hsbR : (s : ℝ) < (b : ℝ) := by exact_mod_cast hsb
  obtain ⟨q, hsq, hqbound⟩ := exists_rat_btwn (lt_min hstR hsbR)
  have hq0 : 0 ≤ q := by
    have hq0R : (0 : ℝ) ≤ (q : ℝ) := le_trans hs0 (le_of_lt hsq)
    exact_mod_cast hq0R
  have hq0R : (0 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq0
  have hqt : (q : ℝ) < (t : ℝ) := lt_of_lt_of_le hqbound (min_le_left _ _)
  have hqb : (q : ℝ) < (b : ℝ) := lt_of_lt_of_le hqbound (min_le_right _ _)
  have hqsNN : s < Real.toNNReal q := by
    have hqsR : (s : ℝ) < (Real.toNNReal q : ℝ) := by
      simpa [Real.coe_toNNReal q hq0R] using hsq
    exact NNReal.coe_lt_coe.mp hqsR
  have hqbNN : Real.toNNReal q < b := by
    have hqbR : (Real.toNNReal q : ℝ) < (b : ℝ) := by
      rw [Real.coe_toNNReal q hq0R]
      exact hqb
    exact NNReal.coe_lt_coe.mp hqbR
  exact ⟨q, hq0, hqt, hb ⟨hqsNN, hqbNN⟩⟩

/-- Deterministic description by rationals (right-continuity): `T_x < t` iff some rational time
before `t` has value above `x`. -/
theorem strictPassageAbove_lt_iff (x : ℝ) (f : DLoc) (t : ℝ≥0) :
    strictPassageAbove x f < t ↔
      ∃ q : ℚ, 0 ≤ q ∧ (q : ℝ) < t ∧ x < f.1 (Real.toNNReal q) := by
  constructor
  · intro h
    have hs : ∃ s : ℝ≥0, ∃ hxs : x < f.1 s, s < t := by
      simpa only [strictPassageAbove, iInf_lt_iff, WithTop.coe_lt_coe] using h
    rcases hs with ⟨s, hxs, hst⟩
    exact exists_rational_time_above x f hst hxs
  · rintro ⟨q, hq0, hqt, hval⟩
    apply iInf_lt_iff.mpr
    refine ⟨Real.toNNReal q, ?_⟩
    apply iInf_lt_iff.mpr
    refine ⟨hval, ?_⟩
    have hq0R : (0 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq0
    exact_mod_cast (Real.toNNReal_lt_iff_lt_coe hq0R).2 hqt

/-- `T_x` is a stopping time of the right-continuous filtration. -/
theorem isStoppingTime_strictPassageAbove (x : ℝ) :
    IsStoppingTime filtration (strictPassageAbove x) := by
  apply MeasureTheory.isStoppingTime_of_measurableSet_lt_of_isRightContinuous
  intro t
  have hset : {f : DLoc | strictPassageAbove x f < t} =
      ⋃ q : {q : ℚ // 0 ≤ q ∧ (q : ℝ) < t},
        {f : DLoc | x < f.1 (Real.toNNReal q.1)} := by
    ext f
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion]
    change strictPassageAbove x f < t ↔
      ∃ q : {q : ℚ // 0 ≤ q ∧ (q : ℝ) < t}, x < f.1 (Real.toNNReal q.1)
    rw [strictPassageAbove_lt_iff]
    constructor
    · rintro ⟨q, hq0, hqt, hval⟩
      exact ⟨⟨q, hq0, hqt⟩, hval⟩
    · rintro ⟨⟨q, hq0, hqt⟩, hval⟩
      exact ⟨q, hq0, hqt, hval⟩
  rw [hset]
  apply MeasurableSet.iUnion
  intro q
  let s : ℝ≥0 := Real.toNNReal q.1
  have hst : s ≤ t := by
    have hq0R : (0 : ℝ) ≤ (q.1 : ℝ) := by exact_mod_cast q.2.1
    have hstR : (s : ℝ) < t := by
      change (Real.toNNReal q.1 : ℝ) < t
      rw [Real.coe_toNNReal q.1 hq0R]
      exact q.2.2
    exact_mod_cast hstR.le
  have hmeas : MeasurableSet[rawFiltration t] {f : DLoc | x < eval s f} :=
    measurableSet_lt measurable_const (measurable_eval_rawFiltration hst)
  exact (rawFiltration.le_rightCont t) _ hmeas

/-- Deterministic reflection identity (audit, F3): `inf{t | f t < -x}` is the strict passage of
`-f` above `x`. -/
theorem strictPassageBelow_neg (x : ℝ) (f : DLoc) :
    strictPassageBelow (-x) f =
      strictPassageAbove x (⟨fun t => -f.1 t, f.2.continuous_comp continuous_neg⟩ : DLoc) := by
  change (⨅ t : ℝ≥0, ⨅ (_ : f.1 t < -x), (t : WithTop ℝ≥0)) =
    ⨅ t : ℝ≥0, ⨅ (_ : x < -f.1 t), (t : WithTop ℝ≥0)
  apply iInf_congr
  intro t
  by_cases h : f.1 t < -x
  · have h' : x < -f.1 t := by linarith
    have hleft : (⨅ (_ : f.1 t < -x), (t : WithTop ℝ≥0)) = (t : WithTop ℝ≥0) := by
      apply le_antisymm
      · exact iInf_le _ h
      · exact le_iInf fun _ => le_rfl
    have hright : (⨅ (_ : x < -f.1 t), (t : WithTop ℝ≥0)) = (t : WithTop ℝ≥0) := by
      apply le_antisymm
      · exact iInf_le _ h'
      · exact le_iInf fun _ => le_rfl
    exact hleft.trans hright.symm
  · have h' : ¬ x < -f.1 t := by intro h'; linarith
    have hleft : (⨅ (_ : f.1 t < -x), (t : WithTop ℝ≥0)) = ⊤ := by
      apply le_antisymm le_top
      apply le_iInf
      intro hp
      exact (h hp).elim
    have hright : (⨅ (_ : x < -f.1 t), (t : WithTop ℝ≥0)) = ⊤ := by
      apply le_antisymm le_top
      apply le_iInf
      intro hp
      exact (h' hp).elim
    exact hleft.trans hright.symm

/-- `inf {t | f t < x}` is a stopping time of the right-continuous filtration. -/
theorem isStoppingTime_strictPassageBelow (x : ℝ) :
    IsStoppingTime filtration (strictPassageBelow x) := by
  apply MeasureTheory.isStoppingTime_of_measurableSet_lt_of_isRightContinuous
  intro t
  have hset : {f : DLoc | strictPassageBelow x f < t} =
      ⋃ q : {q : ℚ // 0 ≤ q ∧ (q : ℝ) < t},
        {f : DLoc | f.1 (Real.toNNReal q.1) < x} := by
    ext f
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion]
    change strictPassageBelow x f < t ↔
      ∃ q : {q : ℚ // 0 ≤ q ∧ (q : ℝ) < t}, f.1 (Real.toNNReal q.1) < x
    have hreflect : strictPassageBelow x f =
        strictPassageAbove (-x)
          (⟨fun u => -f.1 u, f.2.continuous_comp continuous_neg⟩ : DLoc) := by
      simpa only [neg_neg] using strictPassageBelow_neg (-x) f
    have hrat := strictPassageAbove_lt_iff (-x)
      (⟨fun u => -f.1 u, f.2.continuous_comp continuous_neg⟩ : DLoc) t
    rw [hreflect, hrat]
    constructor
    · rintro ⟨q, hq0, hqt, hval⟩
      refine ⟨⟨q, hq0, hqt⟩, ?_⟩
      simpa using (neg_lt_neg_iff.mp hval)
    · rintro ⟨⟨q, hq0, hqt⟩, hval⟩
      refine ⟨q, hq0, hqt, ?_⟩
      simpa using (neg_lt_neg_iff.mpr hval)
  rw [hset]
  apply MeasurableSet.iUnion
  intro q
  let s : ℝ≥0 := Real.toNNReal q.1
  have hst : s ≤ t := by
    have hq0R : (0 : ℝ) ≤ (q.1 : ℝ) := by exact_mod_cast q.2.1
    have hstR : (s : ℝ) < t := by
      change (Real.toNNReal q.1 : ℝ) < t
      rw [Real.coe_toNNReal q.1 hq0R]
      exact q.2.2
    exact_mod_cast hstR.le
  have hmeas : MeasurableSet[rawFiltration t] {f : DLoc | eval s f < x} :=
    measurableSet_lt (measurable_eval_rawFiltration hst) measurable_const
  exact (rawFiltration.le_rightCont t) _ hmeas


end DLoc

