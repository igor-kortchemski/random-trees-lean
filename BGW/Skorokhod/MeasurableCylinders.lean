module

public import BGW.Skorokhod.Measurable
public import BGW.Skorokhod.Separable
import BGW.Skorokhod.CompleteMetric
import Mathlib.MeasureTheory.Constructions.Polish.Basic
public import Mathlib.Topology.MetricSpace.Completion

/-!
# Cylinder generation of the Skorokhod Borel structure

For a complete state space, countable dense evaluations give a Borel embedding.
An isometric embedding into the completion removes the completeness assumption.
-/

@[expose] public section

namespace BGW.Skorokhod

open Set Filter Topology
open UniformSpace

variable {T : ℝ} {E : Type*}

/-- Dense evaluations, including the terminal evaluation, determine a càdlàg path. -/
theorem eq_of_eval_eq_on_dense [MetricSpace E] {S : Set (Icc (0 : ℝ) T)} (hS : Dense S)
    (hT0 : 0 ≤ T) (hTS : (⟨T, hT0, le_rfl⟩ : Icc (0 : ℝ) T) ∈ S)
    {f g : D T E} (hfg : ∀ t ∈ S, f t = g t) : f = g := by
  classical
  apply BGW.Skorokhod.ext
  intro t
  by_cases ht : (t : ℝ) = T
  · have heq : t = ⟨T, hT0, le_rfl⟩ := Subtype.ext ht
    exact hfg t (heq ▸ hTS)
  have htT : (t : ℝ) < T := lt_of_le_of_ne t.2.2 ht
  let r : ℕ → ℝ := fun n => 1 / (n + 1 : ℝ)
  have hr (n : ℕ) : 0 < r n := by dsimp [r]; positivity
  have hex (n : ℕ) : ∃ q ∈ S, t < q ∧ (q : ℝ) < (t : ℝ) + r n := by
    let d := min (T - t) (r n) / 2
    have hd : 0 < d := half_pos (lt_min (sub_pos.mpr htT) (hr n))
    have hdT : d < T - t := by
      have := min_le_left (T - t) (r n)
      dsimp [d] at *
      linarith
    have hdr : d < r n := by
      have := min_le_right (T - t) (r n)
      dsimp [d] at *
      linarith
    let u : Icc (0 : ℝ) T := ⟨t + d, by linarith [t.2.1], by linarith⟩
    have hopen : IsOpen {q : Icc (0 : ℝ) T | t < q ∧ (q : ℝ) < (t : ℝ) + r n} :=
      isOpen_Ioi.inter (isOpen_lt continuous_subtype_val continuous_const)
    apply hS.exists_mem_open hopen
    refine ⟨u, ?_⟩
    change (t : ℝ) < (t : ℝ) + d ∧ (t : ℝ) + d < (t : ℝ) + r n
    constructor <;> linarith
  choose q hqS hqt hqr using hex
  have hr0 : Tendsto r atTop (𝓝 0) := by
    simpa only [r, one_div, Function.comp_def] using tendsto_inv_atTop_zero.comp
      (tendsto_atTop_add_const_right atTop (1 : ℝ) tendsto_natCast_atTop_atTop)
  have hq : Tendsto (fun n => (q n : ℝ)) atTop (𝓝 (t : ℝ)) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
      (by simpa using tendsto_const_nhds.add hr0)
      (fun n => (hqt n).le) (fun n => (hqr n).le)
  have hqw : Tendsto q atTop (𝓝[Ioi t] t) :=
    tendsto_nhdsWithin_iff.mpr ⟨tendsto_subtype_rng.mpr hq,
      Filter.Eventually.of_forall hqt⟩
  have hf := ((isCadlag f).isRightContinuous t).tendsto.comp hqw
  have hg := ((isCadlag g).isRightContinuous t).tendsto.comp hqw
  apply tendsto_nhds_unique hf
  convert hg using 1
  funext n
  exact hfg (q n) (hqS n)

private theorem measurableSpace_le_eval_of_complete [MetricSpace E] [CompleteSpace E]
    [TopologicalSpace.SeparableSpace E] [MeasurableSpace E] [BorelSpace E]
    {S : Set (Icc (0 : ℝ) T)} (hS : Dense S) (hT0 : 0 ≤ T)
    (hTS : (⟨T, hT0, le_rfl⟩ : Icc (0 : ℝ) T) ∈ S) :
    (inferInstance : MeasurableSpace (D T E)) ≤
      ⨆ t ∈ S, MeasurableSpace.comap (fun f : D T E => f t) ‹MeasurableSpace E› := by
  classical
  obtain ⟨K, hKS, hKc, hKd⟩ := hS.exists_countable_dense_subset
  let L := insert (⟨T, hT0, le_rfl⟩ : Icc (0 : ℝ) T) K
  have hLc : L.Countable := hKc.insert _
  let : Countable L := hLc
  have hLd : Dense L := hKd.mono (subset_insert _ _)
  let eval : D T E → L → E := fun f t => f t
  have hm : Measurable eval := Measurable.of_eval fun t => measurable_eval t.val
  have hi : Function.Injective eval := by
    intro f g hfg
    exact eq_of_eval_eq_on_dense hLd hT0 (mem_insert _ _) (fun t ht =>
      congrFun hfg ⟨t, ht⟩)
  have he := (hm.measurableEmbedding hi).comap_eq
  rw [← he, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  apply iSup_le
  intro t
  rw [MeasurableSpace.comap_comp]
  apply le_iSup_of_le t.val
  apply le_iSup_of_le (show t.val ∈ S from (mem_insert_iff.mp t.property).elim
    (fun h => h ▸ hTS) (fun h => hKS h))
  exact le_rfl

/-- Applying the canonical embedding into the completion to every path value. -/
def toCompletion [MetricSpace E] (f : D T E) : D T (Completion E) :=
  ⟨fun t => (f t : Completion E),
    (isCadlag f).continuous_comp (Completion.continuous_coe E)⟩

/-- The embedding of paths into the completion preserves the J1 distance. -/
theorem isometry_toCompletion [MetricSpace E] : Isometry (toCompletion (T := T) (E := E)) := by
  apply Isometry.of_dist_eq
  intro f g
  simp only [dist_eq_j1Dist, j1Dist, toCompletion, coe_mk, Completion.dist_eq]

/-- For separable `E`, the Borel σ-algebra of `D` is generated by the evaluations at the times
of any dense set containing the terminal time (Billingsley 1999, Theorem 12.5; C4.2). -/
theorem measurableSpace_eq_iSup_comap_eval [MetricSpace E] [TopologicalSpace.SeparableSpace E]
    [MeasurableSpace E] [BorelSpace E] {S : Set (Set.Icc (0 : ℝ) T)} (hS : Dense S)
    (hT0 : 0 ≤ T) (hTS : (⟨T, hT0, le_rfl⟩ : Set.Icc (0 : ℝ) T) ∈ S) :
    (inferInstance : MeasurableSpace (D T E)) =
      ⨆ t ∈ S, MeasurableSpace.comap (fun f : D T E => f t) ‹MeasurableSpace E› := by
  apply le_antisymm
  · let : MeasurableSpace (Completion E) := borel _
    let : BorelSpace (Completion E) := ⟨rfl⟩
    have heq : (inferInstance : MeasurableSpace (D T E)) =
        MeasurableSpace.comap toCompletion
          (inferInstance : MeasurableSpace (D T (Completion E))) := by
      change borel (D T E) = (borel (D T (Completion E))).comap toCompletion
      rw [← borel_comap]
      exact congrArg (fun top : TopologicalSpace (D T E) => @borel (D T E) top)
        (isometry_toCompletion (T := T) (E := E)).isEmbedding.isInducing.eq_induced
    rw [heq]
    apply le_trans (MeasurableSpace.comap_mono
      (measurableSpace_le_eval_of_complete (E := Completion E) hS hT0 hTS))
    simp_rw [MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    apply le_iSup_of_le t
    apply le_iSup_of_le ht
    change MeasurableSpace.comap (fun f : D T E => (f t : Completion E)) _ ≤ _
    have hm : Measurable (fun x : E => (x : Completion E)) :=
      (Completion.continuous_coe E).measurable
    simpa only [MeasurableSpace.comap_comp, Function.comp_def] using
      (MeasurableSpace.comap_mono (g := fun f : D T E => f t) hm.comap_le)
  · exact iSup_le fun t => iSup_le fun _ => (measurable_eval t).comap_le

end BGW.Skorokhod
