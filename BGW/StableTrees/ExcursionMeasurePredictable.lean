module

public import BGW.StableTrees.ExcursionMeasureCompensationStep

/-! Generators and measurable sections for the stopped-filtration predictable sigma algebra.

See Bertoin, *Lévy Processes*, Chapter IV, and Kallenberg,
*Foundations of Modern Probability*, Chapters 12 and 22.
-/

@[expose] public section

open MeasureTheory MeasurableSpace Set Filter Topology ProbabilityTheory
open scoped NNReal ENNReal
open BGW.Skorokhod

namespace BGW.StableTrees

-- Returns a `MeasurableSpace` used only as an explicit σ-algebra argument, never as an instance.
set_option warn.classDefReducibility false in
/-- **The predictable `σ`-algebra** on `ℝ≥0 × DLoc` of the filtration `G_x = F_{T_x}`
(`(isStoppingTime_firstPassageBelow x).measurableSpace`): generated by the rectangles
`(a,b] × F` with `a ≤ b`, `F ∈ G_a`, and `{0} × F` with `F ∈ G_0`.  (Not packaged as a Mathlib
`Filtration`, to avoid proving monotonicity/`≤ m` of `G` just for the statement.) -/
def predictableSigma : MeasurableSpace (ℝ≥0 × DLoc) :=
  MeasurableSpace.generateFrom
      {S | ∃ (a b : ℝ≥0) (F : Set DLoc), a ≤ b ∧
        MeasurableSet[(isStoppingTime_firstPassageBelow a).measurableSpace] F ∧
        S = Ioc a b ×ˢ F} ⊔
    MeasurableSpace.generateFrom
      {S | ∃ F : Set DLoc,
        MeasurableSet[(isStoppingTime_firstPassageBelow 0).measurableSpace] F ∧
        S = ({0} : Set ℝ≥0) ×ˢ F}

/-- The elementary rectangles generating the stopped-filtration predictable sigma algebra. -/
def excursionPredictableRectangles : Set (Set (ℝ≥0 × DLoc)) :=
  {S | ∃ (a b : ℝ≥0) (F : Set DLoc), a ≤ b ∧
    MeasurableSet[(isStoppingTime_firstPassageBelow a).measurableSpace] F ∧
    S = Ioc a b ×ˢ F} ∪
  {S | ∃ F : Set DLoc,
    MeasurableSet[(isStoppingTime_firstPassageBelow 0).measurableSpace] F ∧
    S = ({0} : Set ℝ≥0) ×ˢ F}

/-- Predictable measurability is generated by elementary rectangles and the whole space. -/
theorem predictableSigma_eq_generate : predictableSigma =
    generateFrom (insert univ excursionPredictableRectangles) := by
  rw [MeasurableSpace.generateFrom_insert_univ]
  exact generateFrom_sup_generateFrom

/-- The elementary predictable rectangles form a pi system. -/
theorem isPiSystem_excursionPredictableRectangles : IsPiSystem excursionPredictableRectangles := by
  intro S hS U hU hne
  rcases hS with ⟨a, b, F, hab, hF, rfl⟩ | ⟨F, hF, rfl⟩ <;>
    rcases hU with ⟨c, d, G, hcd, hG, rfl⟩ | ⟨G, hG, rfl⟩
  · refine Or.inl ⟨max a c, min b d, F ∩ G, ?_, ?_, ?_⟩
    · obtain ⟨p, hp, hq⟩ := hne
      exact (max_lt hp.1.1 hq.1.1).le.trans (le_min hp.1.2 hq.1.2)
    · have hF' : MeasurableSet[(isStoppingTime_firstPassageBelow (max a c)).measurableSpace]
          F := (IsStoppingTime.measurableSpace_mono
            (isStoppingTime_firstPassageBelow a) (isStoppingTime_firstPassageBelow (max a c))
            (fun f => firstPassageBelow_mono f (le_max_left a c))) F hF
      have hG' : MeasurableSet[(isStoppingTime_firstPassageBelow (max a c)).measurableSpace]
          G := (IsStoppingTime.measurableSpace_mono
            (isStoppingTime_firstPassageBelow c) (isStoppingTime_firstPassageBelow (max a c))
            (fun f => firstPassageBelow_mono f (le_max_right a c))) G hG
      exact hF'.inter hG'
    · rw [prod_inter_prod, Ioc_inter_Ioc]
  · obtain ⟨p, hp, hq⟩ := hne
    have hz : p.1 = 0 := hq.1
    have hn : a < 0 := hz ▸ hp.1.1
    exact (not_lt_of_ge (show 0 ≤ a from bot_le) hn).elim
  · obtain ⟨p, hp, hq⟩ := hne
    have hz : p.1 = 0 := hp.1
    have hn : c < 0 := hz ▸ hq.1.1
    exact (not_lt_of_ge (show 0 ≤ c from bot_le) hn).elim
  · refine Or.inr ⟨F ∩ G, hF.inter hG, ?_⟩
    simp only [prod_inter_prod, inter_self]

/-- Every predictable set is measurable for the ambient product sigma algebra. -/
theorem predictableSigma_le_prod :
    predictableSigma ≤ (inferInstance : MeasurableSpace (ℝ≥0 × DLoc)) := by
  rw [predictableSigma_eq_generate]
  apply generateFrom_le
  rintro S (rfl | hS)
  · exact MeasurableSet.univ
  rcases hS with ⟨a, b, F, _, hF, rfl⟩ | ⟨F, hF, rfl⟩
  · exact measurableSet_Ioc.prod ((isStoppingTime_firstPassageBelow a).measurableSpace_le F hF)
  · exact (measurableSet_singleton 0).prod
      ((isStoppingTime_firstPassageBelow 0).measurableSpace_le F hF)

/-- At a fixed sample path, the time section into the predictable space is measurable. -/
theorem measurable_predictable_timeSection (f : DLoc) :
    @Measurable _ _ inferInstance predictableSigma (fun x : ℝ≥0 => (x, f)) := by
  rw [predictableSigma_eq_generate]
  apply measurable_generateFrom
  rintro S (rfl | hS)
  · simp
  rcases hS with ⟨a, b, F, _, _, rfl⟩ | ⟨F, _, rfl⟩ <;>
    by_cases hf : f ∈ F
  · simp [hf]
  · simp [hf]
  · simp [hf]
  · simp [hf]

end BGW.StableTrees
