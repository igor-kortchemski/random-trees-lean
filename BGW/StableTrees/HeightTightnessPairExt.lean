module

public import BGW.StableTrees.HeightTightnessBasic
import Mathlib.MeasureTheory.Constructions.Projective

/-!
# Determination of a joint walk and continuous-height law

Keeping the whole walk and observing the height at arbitrary finite sets of
times determines the joint law. Projective uniqueness identifies the associated
coordinate laws; the Borel sigma algebra of continuous paths is generated by
evaluations.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Set
open scoped Topology ENNReal NNReal Classical
open BGW.Skorokhod
namespace BGW.StableTrees.HeightTightness

/-- Keep the whole walk and observe the height at finitely many deterministic times. -/
def heightPairEval (T : ℝ≥0) {r : ℕ} (t : Fin r → Set.Icc (0 : ℝ) (T : ℝ))
    (p : D (T : ℝ) ℝ × C(Set.Icc (0 : ℝ) (T : ℝ), ℝ)) :
    D (T : ℝ) ℝ × (Fin r → ℝ) := (p.1, fun i => p.2 (t i))

/-- Finite height observation with the whole walk is continuous. -/
theorem continuous_heightPairEval (T : ℝ≥0) {r : ℕ}
    (t : Fin r → Set.Icc (0 : ℝ) (T : ℝ)) : Continuous (heightPairEval T t) := by
  exact continuous_fst.prodMk (continuous_pi fun i =>
    (continuous_eval_const (t i)).comp continuous_snd)

/-- The whole walk together with all finite height observations determines the joint path law. -/
theorem pairLaw_ext_of_height_observations {T : ℝ≥0}
    {P Q : ProbabilityMeasure (D (T : ℝ) ℝ × C(Set.Icc (0 : ℝ) (T : ℝ), ℝ))}
    (h : ∀ {r : ℕ} (t : Fin r → Set.Icc (0 : ℝ) (T : ℝ)),
      P.map (heightPairEval T t) = Q.map (heightPairEval T t)) : P = Q := by
  let X := Set.Icc (0 : ℝ) (T : ℝ)
  let W := D (T : ℝ) ℝ
  let S := W × C(X, ℝ)
  let E : S → X → W × ℝ := fun p t => (p.1, p.2 t)
  have hE : Measurable E := Measurable.of_eval fun t =>
    measurable_fst.prodMk ((ContinuousMap.measurable_eval t).comp measurable_snd)
  let F (s : Finset X) : S → s → W × ℝ := fun p t => E p t
  have hfin (s : Finset X) : P.toMeasure.map (F s) = Q.toMeasure.map (F s) := by
    let e : Fin (Fintype.card s) ≃ s := (Fintype.equivFin s).symm
    let t : Fin (Fintype.card s) → X := fun i => (e i).val
    let k : (W × (Fin (Fintype.card s) → ℝ)) → s → W × ℝ :=
      fun p i => (p.1, p.2 (e.symm i))
    have hk : Measurable k := Measurable.of_eval fun _ =>
      measurable_fst.prodMk ((measurable_pi_apply _).comp measurable_snd)
    have hh := congrArg (fun ν : ProbabilityMeasure (W × (Fin (Fintype.card s) → ℝ)) =>
      ν.toMeasure.map k) (h t)
    simp only [ProbabilityMeasure.toMeasure_map,
      Measure.map_map hk (continuous_heightPairEval T t).measurable] at hh
    have he : k ∘ heightPairEval T t = F s := by
      funext p i
      dsimp only [k, heightPairEval, t, F, E, Function.comp_def]
      rw [e.apply_symm_apply]
    rw [he] at hh
    exact hh
  let R (s : Finset X) := P.toMeasure.map (F s)
  let (s : Finset X) : IsFiniteMeasure (R s) := inferInstance
  have hmaps : P.toMeasure.map E = Q.toMeasure.map E := by
    apply IsProjectiveLimit.unique (P := R)
    · intro s
      rw [Measure.map_map (Finset.measurable_restrict s) hE]
      rfl
    · intro s
      rw [Measure.map_map (Finset.measurable_restrict s) hE]
      exact (hfin s).symm
  have hmE :
      Measurable[MeasurableSpace.comap E (inferInstance : MeasurableSpace (X → W × ℝ))] E :=
    comap_measurable E
  let z : X := ⟨0, le_rfl, T.coe_nonneg⟩
  have hfst :
      Measurable[MeasurableSpace.comap E (inferInstance : MeasurableSpace (X → W × ℝ))]
        (fun p : S => p.1) := by
    simpa only [E, Function.comp_def] using
      (measurable_fst.comp (measurable_pi_apply z)).comp hmE
  have hsnd :
      Measurable[MeasurableSpace.comap E (inferInstance : MeasurableSpace (X → W × ℝ))]
        (fun p : S => p.2) := by
    let : MeasurableSpace S := MeasurableSpace.comap E
      (inferInstance : MeasurableSpace (X → W × ℝ))
    apply ContinuousMap.measurable_iff_eval.mpr
    intro t
    exact (measurable_snd.comp (measurable_pi_apply t)).comp hmE
  have hm : MeasurableSpace.comap E (inferInstance : MeasurableSpace (X → W × ℝ)) =
      (inferInstance : MeasurableSpace S) := by
    apply le_antisymm (measurable_iff_comap_le.mp hE)
    have hid :
        Measurable[MeasurableSpace.comap E (inferInstance : MeasurableSpace (X → W × ℝ))]
          (fun p : S => p) := hfst.prodMk hsnd
    have hle := measurable_iff_comap_le.mp hid
    have hidmap : MeasurableSpace.comap (fun p : S => p) (inferInstance : MeasurableSpace S) =
        (inferInstance : MeasurableSpace S) := MeasurableSpace.comap_id
    rw [hidmap] at hle
    exact hle
  apply ProbabilityMeasure.toMeasure_injective
  apply Measure.ext
  intro A hA
  have hA' :
      MeasurableSet[MeasurableSpace.comap E (inferInstance : MeasurableSpace (X → W × ℝ))] A := by
    rw [hm]
    exact hA
  obtain ⟨B, hB, rfl⟩ := hA'
  rw [← Measure.map_apply hE hB, ← Measure.map_apply hE hB]
  exact congrArg (fun ν : Measure (X → W × ℝ) => ν B) hmaps

end BGW.StableTrees.HeightTightness
