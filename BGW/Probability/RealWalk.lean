module

public import Mathlib.Probability.Independence.InfinitePi
public import Mathlib.Probability.Independence.CharacteristicFunction
public import Mathlib.MeasureTheory.Measure.ProbabilityMeasure

/-!
# Canonical real iid walks

This file constructs the canonical independent real sequence with values in `ℕ → ℝ`, its
partial and block sums, and proves the fresh-start independence and product-law formulas.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace BGW.Probability.RealWalk

/-- The partial sum `ω 0 + ⋯ + ω (m-1)`. -/
def partialSum (ω : ℕ → ℝ) (m : ℕ) : ℝ := ∑ i ∈ Finset.range m, ω i

/-- The block sum `ω a + ⋯ + ω (a+m-1)`. -/
def blockSum (ω : ℕ → ℝ) (a m : ℕ) : ℝ := ∑ i ∈ Finset.range m, ω (a + i)

/-- The prefix `(ω 0, …, ω (m-1))`. -/
def prefixVec (m : ℕ) (ω : ℕ → ℝ) : Fin m → ℝ := fun i => ω i

/-- The shifted sequence `i ↦ ω (k + i)`. -/
def shift (k : ℕ) (ω : ℕ → ℝ) : ℕ → ℝ := fun i => ω (k + i)

/-- The block `(ω a, …, ω (a+m-1))`. -/
def blockVec (a m : ℕ) (ω : ℕ → ℝ) : Fin m → ℝ := fun i => ω (a + i)

theorem partialSum_eq_blockSum (ω : ℕ → ℝ) (m : ℕ) :
    partialSum ω m = blockSum ω 0 m := by
  simp [partialSum, blockSum]

theorem blockSum_eq_partialSum_shift (ω : ℕ → ℝ) (a m : ℕ) :
    blockSum ω a m = partialSum (shift a ω) m := by
  rfl

theorem partialSum_add (ω : ℕ → ℝ) (m k : ℕ) :
    partialSum ω (m + k) = partialSum ω m + blockSum ω m k := by
  exact Finset.sum_range_add (fun i => ω i) m k

theorem measurable_partialSum (m : ℕ) : Measurable fun ω : ℕ → ℝ => partialSum ω m := by
  unfold partialSum
  fun_prop

theorem measurable_blockSum (a m : ℕ) : Measurable fun ω : ℕ → ℝ => blockSum ω a m := by
  unfold blockSum
  fun_prop

theorem measurable_prefixVec (m : ℕ) : Measurable (prefixVec m) := by
  unfold prefixVec
  fun_prop

theorem measurable_shift (k : ℕ) : Measurable (shift k) := by
  unfold shift
  fun_prop

theorem measurable_blockVec (a m : ℕ) : Measurable (blockVec a m) := by
  unfold blockVec
  fun_prop

/-- The canonical real iid law `ν ^ ⊗ ℕ` on sequences. -/
noncomputable def iidLaw (ν : ProbabilityMeasure ℝ) : ProbabilityMeasure (ℕ → ℝ) :=
  ⟨Measure.infinitePi (fun _ : ℕ => (ν : Measure ℝ)), inferInstance⟩

theorem coe_iidLaw (ν : ProbabilityMeasure ℝ) :
    (iidLaw ν : Measure (ℕ → ℝ)) =
      Measure.infinitePi (fun _ : ℕ => (ν : Measure ℝ)) := by
  rfl

/-- The coordinates are independent under `iidLaw ν`. -/
theorem iIndepFun_coord (ν : ProbabilityMeasure ℝ) :
    iIndepFun (fun (i : ℕ) (ω : ℕ → ℝ) => ω i) (iidLaw ν : Measure (ℕ → ℝ)) := by
  exact iIndepFun_infinitePi (X := fun _ (x : ℝ) => x) (by fun_prop)

/-- Every coordinate has law `ν`. -/
theorem map_coord (ν : ProbabilityMeasure ℝ) (i : ℕ) :
    Measure.map (fun ω : ℕ → ℝ => ω i) (iidLaw ν : Measure (ℕ → ℝ)) =
      (ν : Measure ℝ) := by
  exact Measure.infinitePi_map_eval (fun _ : ℕ => (ν : Measure ℝ)) i

/-- The prefix of length `m` has the product law. -/
theorem iidLaw_map_prefix (ν : ProbabilityMeasure ℝ) (m : ℕ) :
    Measure.map (prefixVec m) (iidLaw ν : Measure (ℕ → ℝ)) =
      Measure.pi (fun _ : Fin m => (ν : Measure ℝ)) := by
  rw [coe_iidLaw]
  change Measure.map (fun ω (i : Fin m) => ω (i : ℕ))
    (Measure.infinitePi (fun _ : ℕ => (ν : Measure ℝ))) = _
  rw [Measure.map_infinitePi_infinitePi_of_inj (f := fun i : Fin m => (i : ℕ)) Fin.val_injective,
    Measure.infinitePi_eq_pi]

/-- Any block of length `m` (starting anywhere) has the product law. -/
theorem iidLaw_map_block (ν : ProbabilityMeasure ℝ) (a m : ℕ) :
    Measure.map (blockVec a m) (iidLaw ν : Measure (ℕ → ℝ)) =
      Measure.pi (fun _ : Fin m => (ν : Measure ℝ)) := by
  rw [coe_iidLaw]
  change Measure.map (fun ω (i : Fin m) => ω (a + (i : ℕ)))
    (Measure.infinitePi (fun _ : ℕ => (ν : Measure ℝ))) = _
  have hinj : Function.Injective (fun i : Fin m => a + (i : ℕ)) := fun _ _ h =>
    Fin.ext (Nat.add_left_cancel h)
  rw [Measure.map_infinitePi_infinitePi_of_inj (f := fun i : Fin m => a + (i : ℕ)) hinj,
    Measure.infinitePi_eq_pi]

/-- Independence of the σ-algebras generated by two disjoint families of coordinates. -/
private theorem indep_comaps_of_disjoint (ν : ProbabilityMeasure ℝ) {S T : Set ℕ}
    (hST : Disjoint S T) :
    Indep (⨆ i ∈ S, MeasurableSpace.comap (fun ω : ℕ → ℝ => ω i) inferInstance)
      (⨆ i ∈ T, MeasurableSpace.comap (fun ω : ℕ → ℝ => ω i) inferInstance)
      (iidLaw ν : Measure (ℕ → ℝ)) := by
  exact indep_iSup_of_disjoint (fun i => (measurable_pi_apply i).comap_le)
    (iIndepFun_coord ν).iIndep hST

/-- Two disjoint consecutive blocks are independent. -/
theorem indepFun_prefix_suffix (ν : ProbabilityMeasure ℝ) (m k : ℕ) :
    IndepFun (prefixVec m) (blockVec m k) (iidLaw ν : Measure (ℕ → ℝ)) := by
  have hdisj : Disjoint (Set.range fun i : Fin m => (i : ℕ))
      (Set.range fun i : Fin k => m + (i : ℕ)) := by
    rw [Set.disjoint_left]
    rintro _ ⟨i, rfl⟩ ⟨j, hj⟩
    dsimp at hj
    have hi := i.isLt
    omega
  have h := indep_comaps_of_disjoint ν hdisj
  change Indep (MeasurableSpace.comap (fun (ω : ℕ → ℝ) (i : Fin m) => ω i) inferInstance)
    (MeasurableSpace.comap (fun (ω : ℕ → ℝ) (i : Fin k) => ω (m + i)) inferInstance) _
  rw [MeasurableSpace.comap_process_pi, MeasurableSpace.comap_process_pi]
  simpa only [iSup_range] using h

/-- Fresh start: the prefix and shifted-sequence σ-algebras are independent. -/
theorem indep_prefix_shift (ν : ProbabilityMeasure ℝ) (k : ℕ) :
    Indep (MeasurableSpace.comap (prefixVec k) inferInstance)
      (MeasurableSpace.comap (shift k) inferInstance) (iidLaw ν : Measure (ℕ → ℝ)) := by
  have hdisj : Disjoint (Set.range fun i : Fin k => (i : ℕ))
      (Set.range fun i : ℕ => k + i) := by
    rw [Set.disjoint_left]
    rintro _ ⟨i, rfl⟩ ⟨j, hj⟩
    dsimp at hj
    have hi := i.isLt
    omega
  have h := indep_comaps_of_disjoint ν hdisj
  change Indep (MeasurableSpace.comap (fun (ω : ℕ → ℝ) (i : Fin k) => ω i) inferInstance)
    (MeasurableSpace.comap (fun (ω : ℕ → ℝ) (i : ℕ) => ω (k + i)) inferInstance) _
  rw [MeasurableSpace.comap_process_pi, MeasurableSpace.comap_process_pi]
  simpa only [iSup_range] using h

/-- Fresh start, function form. -/
theorem indepFun_prefix_shift (ν : ProbabilityMeasure ℝ) (k : ℕ) :
    IndepFun (prefixVec k) (shift k) (iidLaw ν : Measure (ℕ → ℝ)) := by
  exact indep_prefix_shift ν k

/-- The shifted sequence again has law `iidLaw ν`. -/
theorem iidLaw_map_shift (ν : ProbabilityMeasure ℝ) (k : ℕ) :
    Measure.map (shift k) (iidLaw ν : Measure (ℕ → ℝ)) =
      (iidLaw ν : Measure (ℕ → ℝ)) := by
  rw [coe_iidLaw]
  change Measure.map (fun ω i => ω (k + i))
    (Measure.infinitePi (fun _ : ℕ => (ν : Measure ℝ))) = _
  have hinj : Function.Injective (fun i : ℕ => k + i) := fun _ _ h => Nat.add_left_cancel h
  exact Measure.map_infinitePi_infinitePi_of_inj hinj

/-- Fresh-start product formula for a prefix event `A` and a future event `C`. -/
theorem measure_prefix_inter_shift (ν : ProbabilityMeasure ℝ) (k : ℕ) {A : Set (Fin k → ℝ)}
    (hA : MeasurableSet A) {C : Set (ℕ → ℝ)} (hC : MeasurableSet C) :
    (iidLaw ν : Measure (ℕ → ℝ)) (prefixVec k ⁻¹' A ∩ shift k ⁻¹' C) =
      (iidLaw ν : Measure (ℕ → ℝ)) (prefixVec k ⁻¹' A) *
        (iidLaw ν : Measure (ℕ → ℝ)) C := by
  rw [(indepFun_prefix_shift ν k).measure_inter_preimage_eq_mul A C hA hC,
    ← Measure.map_apply (measurable_shift k) hC, iidLaw_map_shift]

/-- The law of the sum of `m` iid steps. -/
noncomputable def sumLaw (ν : ProbabilityMeasure ℝ) (m : ℕ) : ProbabilityMeasure ℝ :=
  (iidLaw ν).map (fun ω : ℕ → ℝ => partialSum ω m)

theorem coe_sumLaw (ν : ProbabilityMeasure ℝ) (m : ℕ) :
    (sumLaw ν m : Measure ℝ) =
      Measure.map (fun ω : ℕ → ℝ => partialSum ω m)
        (iidLaw ν : Measure (ℕ → ℝ)) := by
  rfl

/-- The law of the sum of `m` iid steps divided by `B m`. -/
noncomputable def scaledSumLaw (ν : ProbabilityMeasure ℝ) (B : ℕ → ℝ) (m : ℕ) :
    ProbabilityMeasure ℝ :=
  (sumLaw ν m).map (fun x : ℝ => x / B m)

/-- A block sum of length `m`, started anywhere, has law `sumLaw ν m`. -/
theorem iidLaw_map_blockSum (ν : ProbabilityMeasure ℝ) (a m : ℕ) :
    Measure.map (fun ω : ℕ → ℝ => blockSum ω a m) (iidLaw ν : Measure (ℕ → ℝ)) =
      (sumLaw ν m : Measure ℝ) := by
  let total : (Fin m → ℝ) → ℝ := fun x => ∑ i, x i
  have htotal : Measurable total := by
    unfold total
    fun_prop
  have hblock : Measure.map (fun ω : ℕ → ℝ => blockSum ω a m)
      (iidLaw ν : Measure (ℕ → ℝ)) = Measure.map total
      (Measure.pi (fun _ : Fin m => (ν : Measure ℝ))) := by
    rw [← iidLaw_map_block ν a m, Measure.map_map htotal (measurable_blockVec a m)]
    congr 1
    funext ω
    exact (Fin.sum_univ_eq_sum_range (fun i => ω (a + i)) m).symm
  have hpartial : Measure.map (fun ω : ℕ → ℝ => partialSum ω m)
      (iidLaw ν : Measure (ℕ → ℝ)) = Measure.map total
      (Measure.pi (fun _ : Fin m => (ν : Measure ℝ))) := by
    rw [← iidLaw_map_prefix ν m, Measure.map_map htotal (measurable_prefixVec m)]
    congr 1
    funext ω
    exact (Fin.sum_univ_eq_sum_range (fun i => ω i) m).symm
  rw [coe_sumLaw]
  exact hblock.trans hpartial.symm

/-- Consecutive block sums are independent. -/
theorem indepFun_blockSum (ν : ProbabilityMeasure ℝ) (m k : ℕ) :
    IndepFun (fun ω : ℕ → ℝ => blockSum ω 0 m) (fun ω : ℕ → ℝ => blockSum ω m k)
      (iidLaw ν : Measure (ℕ → ℝ)) := by
  have h := (indepFun_prefix_suffix ν m k).comp
    (φ := fun v : Fin m → ℝ => ∑ i, v i) (ψ := fun v : Fin k → ℝ => ∑ i, v i)
    (by fun_prop) (by fun_prop)
  have h0 : (fun ω : ℕ → ℝ => blockSum ω 0 m) = (fun ω => ∑ i : Fin m, ω i) := by
    funext ω
    simpa only [blockSum, Nat.zero_add] using
      (Fin.sum_univ_eq_sum_range (fun i => ω i) m).symm
  have h1 : (fun ω : ℕ → ℝ => blockSum ω m k) =
      (fun ω => ∑ i : Fin k, ω (m + i)) := by
    funext ω
    exact (Fin.sum_univ_eq_sum_range (fun i => ω (m + i)) k).symm
  rw [h0, h1]
  simpa only [Function.comp_def, prefixVec, blockVec] using h

/-- The vector-valued blocks associated with pairwise disjoint index intervals are independent. -/
private theorem iIndepFun_blockVec (ν : ProbabilityMeasure ℝ) {k : ℕ} (a m : Fin k → ℕ)
    (hdisj : ∀ i j : Fin k, i < j → a i + m i ≤ a j) :
    iIndepFun (fun i => blockVec (a i) (m i)) (iidLaw ν : Measure (ℕ → ℝ)) := by
  let g : (i : Fin k) × Fin (m i) → ℕ := fun p => a p.1 + (p.2 : ℕ)
  have hg : Function.Injective g := by
    rintro ⟨i, j⟩ ⟨i', j'⟩ heq
    have hii' : i = i' := by
      rcases lt_trichotomy i i' with hij | hij | hij
      · have hlt : a i + (j : ℕ) < a i' := by
          calc
            a i + (j : ℕ) < a i + m i := Nat.add_lt_add_left j.isLt _
            _ ≤ a i' := hdisj i i' hij
        have hle : a i' ≤ a i' + (j' : ℕ) := Nat.le_add_right _ _
        dsimp [g] at heq
        omega
      · exact hij
      · have hlt : a i' + (j' : ℕ) < a i := by
          calc
            a i' + (j' : ℕ) < a i' + m i' := Nat.add_lt_add_left j'.isLt _
            _ ≤ a i := hdisj i' i hij
        have hle : a i ≤ a i + (j : ℕ) := Nat.le_add_right _ _
        dsimp [g] at heq
        omega
    subst i'
    have hjj' : (j : ℕ) = (j' : ℕ) := Nat.add_left_cancel heq
    have : j = j' := Fin.ext hjj'
    subst j'
    rfl
  let flat : (ℕ → ℝ) → ((i : Fin k) × Fin (m i) → ℝ) := fun ω p => ω (g p)
  have hflat : Measurable flat := by
    unfold flat
    fun_prop
  rw [iIndepFun_iff_map_fun_eq_pi_map
    (fun i => (measurable_blockVec (a i) (m i)).aemeasurable)]
  calc
    Measure.map (fun ω i => blockVec (a i) (m i) ω) (iidLaw ν : Measure (ℕ → ℝ)) =
        Measure.map (MeasurableEquiv.piCurry (fun i (_ : Fin (m i)) => ℝ))
          (Measure.map flat (iidLaw ν : Measure (ℕ → ℝ))) := by
      rw [Measure.map_map (MeasurableEquiv.measurable _) hflat]
      congr 1
    _ = Measure.map (MeasurableEquiv.piCurry (fun i (_ : Fin (m i)) => ℝ))
        (Measure.infinitePi (fun _ : (i : Fin k) × Fin (m i) => (ν : Measure ℝ))) := by
      rw [coe_iidLaw]
      exact congrArg _ (Measure.map_infinitePi_infinitePi_of_inj hg)
    _ = Measure.infinitePi (fun i => Measure.infinitePi
        (fun _ : Fin (m i) => (ν : Measure ℝ))) := by
      simpa using Measure.infinitePi_map_piCurry
        (fun (i : Fin k) (_ : Fin (m i)) => (ν : Measure ℝ))
    _ = Measure.pi (fun i => Measure.pi (fun _ : Fin (m i) => (ν : Measure ℝ))) := by
      simp only [Measure.infinitePi_eq_pi]
    _ = Measure.pi (fun i => Measure.map (blockVec (a i) (m i))
        (iidLaw ν : Measure (ℕ → ℝ))) := by
      congr 1
      funext i
      rw [iidLaw_map_block]

/-- Any finite family of pairwise disjoint blocks gives independent sums. -/
theorem iIndepFun_blockSum (ν : ProbabilityMeasure ℝ) {k : ℕ} (a m : Fin k → ℕ)
    (hdisj : ∀ i j : Fin k, i < j → a i + m i ≤ a j) :
    iIndepFun (fun (i : Fin k) (ω : ℕ → ℝ) => blockSum ω (a i) (m i))
      (iidLaw ν : Measure (ℕ → ℝ)) := by
  have h := (iIndepFun_blockVec ν a m hdisj).comp
    (fun i (v : Fin (m i) → ℝ) => ∑ j, v j) (by fun_prop)
  have heq : (fun (i : Fin k) (ω : ℕ → ℝ) => blockSum ω (a i) (m i)) =
      (fun i => (fun v : Fin (m i) → ℝ => ∑ j, v j) ∘ blockVec (a i) (m i)) := by
    funext i ω
    exact (Fin.sum_univ_eq_sum_range (fun j => ω (a i + j)) (m i)).symm
  rw [heq]
  exact h

theorem sumLaw_zero (ν : ProbabilityMeasure ℝ) :
    (sumLaw ν 0 : Measure ℝ) = Measure.dirac 0 := by
  simp [coe_sumLaw, partialSum, Measure.map_const]

private theorem sumLaw_add_aux (ν : ProbabilityMeasure ℝ) (m k : ℕ) :
    (sumLaw ν (m + k) : Measure ℝ) =
      (sumLaw ν m : Measure ℝ) ∗ (sumLaw ν k : Measure ℝ) := by
  have hadd : (fun ω : ℕ → ℝ => partialSum ω (m + k)) =
      (fun ω : ℕ → ℝ => blockSum ω 0 m) + (fun ω : ℕ → ℝ => blockSum ω m k) := by
    funext ω
    simp only [Pi.add_apply]
    rw [partialSum_add, partialSum_eq_blockSum]
  rw [coe_sumLaw ν (m + k), hadd,
    (indepFun_blockSum ν m k).map_add_eq_map_conv_map
      (measurable_blockSum 0 m) (measurable_blockSum m k),
    iidLaw_map_blockSum, iidLaw_map_blockSum]

private theorem sumLaw_one (ν : ProbabilityMeasure ℝ) :
    (sumLaw ν 1 : Measure ℝ) = (ν : Measure ℝ) := by
  rw [← iidLaw_map_blockSum ν 0 1]
  simpa [blockSum] using map_coord ν 0

theorem sumLaw_succ (ν : ProbabilityMeasure ℝ) (m : ℕ) :
    (sumLaw ν (m + 1) : Measure ℝ) = (sumLaw ν m : Measure ℝ) ∗ (ν : Measure ℝ) := by
  rw [sumLaw_add_aux, sumLaw_one]

theorem sumLaw_add (ν : ProbabilityMeasure ℝ) (m k : ℕ) :
    (sumLaw ν (m + k) : Measure ℝ) =
      (sumLaw ν m : Measure ℝ) ∗ (sumLaw ν k : Measure ℝ) := by
  exact sumLaw_add_aux ν m k

/-- The sum law is the law of the sum of coordinates in the finite product space. -/
private theorem sumLaw_eq_map_sum_pi (ν : ProbabilityMeasure ℝ) (m : ℕ) :
    (sumLaw ν m : Measure ℝ) = Measure.map (fun x : Fin m → ℝ => ∑ i, x i)
      (Measure.pi (fun _ : Fin m => (ν : Measure ℝ))) := by
  rw [coe_sumLaw, ← iidLaw_map_prefix ν m,
    Measure.map_map (by fun_prop) (measurable_prefixVec m)]
  congr 1
  funext ω
  exact (Fin.sum_univ_eq_sum_range (fun i => ω i) m).symm

/-- The characteristic function of a sum of `m` iid steps is `charFun ν u ^ m`. -/
theorem charFun_sumLaw (ν : ProbabilityMeasure ℝ) (m : ℕ) (u : ℝ) :
    charFun (sumLaw ν m : Measure ℝ) u = charFun (ν : Measure ℝ) u ^ m := by
  rw [sumLaw_eq_map_sum_pi]
  simpa using congrFun (charFun_map_sum_pi_eq_prod (fun _ : Fin m => (ν : Measure ℝ))) u

/-- Characteristic function of the scaled sum: `charFun ν (u / B m) ^ m`. -/
theorem charFun_scaledSumLaw (ν : ProbabilityMeasure ℝ) (B : ℕ → ℝ) (m : ℕ) (u : ℝ) :
    charFun (scaledSumLaw ν B m : Measure ℝ) u = charFun (ν : Measure ℝ) (u / B m) ^ m := by
  change charFun (Measure.map (fun x : ℝ => x / B m) (sumLaw ν m : Measure ℝ)) u = _
  have hfun : (fun x : ℝ => x / B m) = (fun x : ℝ => (B m)⁻¹ • x) := by
    funext x
    simp [div_eq_mul_inv, mul_comm]
  rw [hfun, charFun_map_smul, charFun_sumLaw]
  congr 2
  simp [div_eq_mul_inv, mul_comm]

end BGW.Probability.RealWalk
