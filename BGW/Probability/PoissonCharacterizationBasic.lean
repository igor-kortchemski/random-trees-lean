module
public import Mathlib.MeasureTheory.Measure.GiryMonad
public import Mathlib.MeasureTheory.Function.Floor
public import Mathlib.Probability.Independence.Integration

/-! Basic definitions and measurability lemmas for time-simple random point measures. -/

@[expose] public section

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped NNReal ENNReal

namespace BGW.Probability

variable {Ω M : Type*} [MeasurableSpace Ω] [MeasurableSpace M]

/-- The count of a set read in `ℕ` (junk `0` for an infinite count, a.s. irrelevant). -/
noncomputable def natCount (μ : Measure (ℝ≥0 × M)) (B : Set (ℝ≥0 × M)) : ℕ :=
  ⌊ENNReal.toNNReal (μ B)⌋₊

/-- The restriction of a point measure to the time window `(a, b]` (all marks). -/
noncomputable def windowRestrict (a b : ℝ≥0) (μ : Measure (ℝ≥0 × M)) :
    Measure (ℝ≥0 × M) :=
  μ.restrict (Ioc a b ×ˢ univ)

/-- The same window, translated to start at time `0`. -/
noncomputable def windowShift (a b : ℝ≥0) (μ : Measure (ℝ≥0 × M)) :
    Measure (ℝ≥0 × M) :=
  Measure.map (fun p : ℝ≥0 × M => (p.1 - a, p.2)) (windowRestrict a b μ)

-- `naturalHistory` returns a `MeasurableSpace` used as an explicit σ-algebra argument, never as an
-- instance, so the reducibility warning for class-valued definitions does not apply.
set_option warn.classDefReducibility false in
/-- The natural history of `ξ` up to time `t`: the `σ`-algebra generated by `ξ` restricted to
`[0,t] × M`. -/
noncomputable def naturalHistory (ξ : Ω → Measure (ℝ≥0 × M)) (t : ℝ≥0) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (ξ ω).restrict (Iic t ×ˢ univ)) inferInstance

/-- **Time-simple finite-rate random point measure**: the structural hypotheses of the
characterization. -/
structure IsTimeSimpleLevy (P : Measure Ω) (ξ : Ω → Measure (ℝ≥0 × M)) : Prop where
  measurable : Measurable ξ
  /-- zero mass at label `0` -/
  atZero : ∀ᵐ ω ∂P, ξ ω ({0} ×ˢ univ) = 0
  /-- **counting measure**: a countable sum of unit point masses. -/
  counting : ∀ᵐ ω ∂P, ∃ S : Set (ℝ≥0 × M), S.Countable ∧
    ξ ω = Measure.sum (fun p : S => Measure.dirac (p : ℝ≥0 × M))
  /-- **time-simplicity**: almost surely at most one mark per time label. -/
  timeSimple : ∀ᵐ ω ∂P, ∀ s : ℝ≥0, ξ ω ({s} ×ˢ univ) ≤ 1
  /-- stationarity of window restrictions -/
  stationary : ∀ a h : ℝ≥0,
    P.map (fun ω => windowShift a (a + h) (ξ ω)) = P.map (fun ω => windowShift 0 h (ξ ω))
  /-- independence of restrictions to consecutive windows -/
  indep : ∀ (n : ℕ) (t : Fin (n + 1) → ℝ≥0), Monotone t →
    iIndepFun (fun i : Fin n => fun ω => windowRestrict (t i.castSucc) (t i.succ) (ξ ω)) P

/-- A measurable set of marks of finite rate: finitely many marks in `(0,t] × A` a.s. -/
def IsFiniteRate (P : Measure Ω) (ξ : Ω → Measure (ℝ≥0 × M)) (A : Set M) : Prop :=
  MeasurableSet A ∧ ∀ t : ℝ≥0, ∀ᵐ ω ∂P, ξ ω (Ioc 0 t ×ˢ A) < ⊤

/-- The mark rate of `A`: `E ξ((0,1] × A)`. -/
noncomputable def markRate (P : Measure Ω) (ξ : Ω → Measure (ℝ≥0 × M))
    (A : Set M) : ℝ≥0∞ :=
  ∫⁻ ω, ξ ω (Ioc 0 1 ×ˢ A) ∂P

variable {P : Measure Ω} [IsProbabilityMeasure P] {ξ : Ω → Measure (ℝ≥0 × M)} {A : Set M}

lemma measurable_box {a b : ℝ≥0} (hA : MeasurableSet A) :
    MeasurableSet (Ioc a b ×ˢ A) :=
  measurableSet_Ioc.prod hA

lemma measurable_count (hξ : Measurable ξ) {B : Set (ℝ≥0 × M)} (hB : MeasurableSet B) :
    Measurable (fun ω => ξ ω B) :=
  (Measure.measurable_coe hB).comp hξ

lemma measurable_natCount (hξ : Measurable ξ) {B : Set (ℝ≥0 × M)}
    (hB : MeasurableSet B) : Measurable (fun ω => natCount (ξ ω) B) := by
  exact Nat.measurable_floor.comp (measurable_count hξ hB).ennreal_toNNReal

lemma measurable_restrict_pointMeasure (hξ : Measurable ξ) {B : Set (ℝ≥0 × M)}
    (hB : MeasurableSet B) : Measurable (fun ω => (ξ ω).restrict B) := by
  apply Measure.measurable_of_measurable_coe
  intro C hC
  simp only [Measure.restrict_apply' hB]
  exact measurable_count hξ (hC.inter hB)

lemma measurable_windowRestrict (hξ : Measurable ξ) (a b : ℝ≥0) :
    Measurable (fun ω => windowRestrict a b (ξ ω)) :=
  measurable_restrict_pointMeasure hξ (measurableSet_Ioc.prod MeasurableSet.univ)

lemma measurable_windowShift (hξ : Measurable ξ) (a b : ℝ≥0) :
    Measurable (fun ω => windowShift a b (ξ ω)) := by
  apply Measure.measurable_map _ (by fun_prop) |>.comp
  exact measurable_windowRestrict hξ a b

lemma measurable_historyRestriction (hξ : Measurable ξ) (s : ℝ≥0) :
    Measurable (fun ω => (ξ ω).restrict (Iic s ×ˢ univ)) :=
  measurable_restrict_pointMeasure hξ (measurableSet_Iic.prod MeasurableSet.univ)

omit [IsProbabilityMeasure P] in
lemma measurable_markRate (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A) :
    Measurable (fun ω => ξ ω (Ioc 0 1 ×ˢ A)) :=
  measurable_count hξ.measurable (measurable_box hA.1)

lemma restrict_apply_box (μ : Measure (ℝ≥0 × M)) {a b : ℝ≥0} (_hA : MeasurableSet A) :
    windowRestrict a b μ (Ioc 0 (b - a) ×ˢ A) =
      μ ((Ioc 0 (b - a) ×ˢ A) ∩ (Ioc a b ×ˢ univ)) := by
  exact Measure.restrict_apply' (measurableSet_Ioc.prod MeasurableSet.univ)

end BGW.Probability
