import BGW.StableTrees.StableProcess
import BGW.Skorokhod.MeasurableMaps
import BGW.Skorokhod.MeasurableCylinders
import BGW.Skorokhod.Restrict
import BGW.Skorokhod.Scaling

/-! Contract probe for CT.C16 blueprint Node 17 (P2, time-space scaling) and Node 19 (P5, simple
Markov property as independence of whole paths).

Maintained files (proposed): `BGW/Skorokhod/Shift.lean` (`shiftIncrement`, its measurability and
the natural-past identification) and `BGW/StableTrees/StableProcessMarkov.lean`
(`stableProcessLaw_scaling`, `stableProcessLaw_simpleMarkov`).

Notes.
* `timeSpaceScale a hT (f, k, c)` has type `D a E` and is `t ↦ k * f (min (c * t) T)`; the
  sealed lemma `IsStableLevyLaw.map_timeSpaceScale` is the Node 17 ingredient: Node 17 follows
  from it and `eq_stableProcessLaw_iff`. The pair `(k, c)` is `(c ^ (-(1/θ)), ⟨c, hc⟩)`.
* `shiftIncrement` is a real definition; the càdlàg obligation is proved (composition with the
  continuous monotone translation `t ↦ s + t` and subtraction of a constant), no `sorry` there.
* Edge cases: `s = 0` gives `restrict` to `D 0 ℝ` and a shift equal to `f` a.s.; `s = T` gives
  `D 0 ℝ` and the zero path, whose law is `stableProcessLaw θ 0` (the junk Dirac at the zero
  path, which is the true zero-horizon law). No strong Markov claim. -/

open MeasureTheory ProbabilityTheory
open scoped Topology

namespace BGW.Skorokhod

/-- The increment path after the deterministic time `s`: `t ↦ f (s + t) - f s` on `[0, T - s]`. -/
noncomputable def shiftIncrement {T s : ℝ} (hs : 0 ≤ s) (hsT : s ≤ T) (f : D T ℝ) :
    D (T - s) ℝ where
  toFun t := f ⟨s + t, add_nonneg hs t.2.1, by linarith [t.2.2]⟩ - f ⟨s, hs, hsT⟩
  isCadlag' := by
    let inc : Set.Icc (0 : ℝ) (T - s) → Set.Icc (0 : ℝ) T := fun t =>
      ⟨s + t, add_nonneg hs t.2.1, by linarith [t.2.2]⟩
    have hinc : Continuous inc :=
      Continuous.subtype_mk (continuous_const.add continuous_subtype_val) _
    have hcad : IsCadlag (f ∘ inc) := by
      constructor
      · intro x
        have hmap : Set.MapsTo inc (Set.Ioi x) (Set.Ioi (inc x)) := by
          intro y hy
          change (y : ℝ) > (x : ℝ) at hy
          change s + (y : ℝ) > s + (x : ℝ)
          linarith
        exact (isCadlag f).isRightContinuous (inc x) |>.comp
          (hinc.continuousAt.continuousWithinAt) hmap
      · intro x
        obtain ⟨l, hl⟩ := (isCadlag f).tendsto_nhdsLT (inc x)
        have hmem : ∀ᶠ y in nhdsWithin x (Set.Iio x), inc y ∈ Set.Iio (inc x) := by
          filter_upwards [self_mem_nhdsWithin] with y hy
          change (y : ℝ) < (x : ℝ) at hy
          change s + (y : ℝ) < s + (x : ℝ)
          linarith
        have hincLeft : Filter.Tendsto inc (nhdsWithin x (Set.Iio x))
            (nhdsWithin (inc x) (Set.Iio (inc x))) :=
          tendsto_nhdsWithin_iff.mpr
            ⟨tendsto_nhdsWithin_of_tendsto_nhds hinc.continuousAt, hmem⟩
        exact ⟨l, hl.comp hincLeft⟩
    exact hcad.continuous_comp (g := fun y : ℝ => y - f ⟨s, hs, hsT⟩) (by fun_prop)

/-- `shiftIncrement` is Borel measurable. -/
theorem measurable_shiftIncrement {T s : ℝ} (hs : 0 ≤ s) (hsT : s ≤ T) :
    Measurable (shiftIncrement hs hsT) := sorry

/-- Natural-past identification: the σ-algebra pulled back by `restrict hsT` is the σ-algebra
generated by the evaluations at times `≤ s` (both sides are σ-algebras on `D T ℝ`). -/
theorem comap_restrict_eq_iSup_comap_eval {T s : ℝ} (hsT : s ≤ T) :
    MeasurableSpace.comap (restrict (E := ℝ) hsT) (inferInstance : MeasurableSpace (D s ℝ)) =
      ⨆ t : {t : Set.Icc (0 : ℝ) T // (t : ℝ) ≤ s},
        MeasurableSpace.comap (fun f : D T ℝ => f t.1) (inferInstance : MeasurableSpace ℝ) :=
  sorry

end BGW.Skorokhod

namespace BGW.StableTrees

open BGW.Skorokhod

/-- Node 17 (P2): time-space scaling of the stable process law from horizon `c * T` to `T`. -/
theorem stableProcessLaw_scaling {θ T : ℝ} (hθ : 1 < θ ∧ θ ≤ 2) (hT : 0 < T)
    {c : ℝ} (hc : 0 < c) :
    (stableProcessLaw θ (c * T)).map
        (fun f : D (c * T) ℝ => timeSpaceScale T (mul_pos hc hT).le
          (f, c ^ (-(1 / θ)), (⟨c, Set.mem_Ioi.mpr hc⟩ : Set.Ioi (0 : ℝ)))) =
      stableProcessLaw θ T := sorry

/-- Node 19 (P5): simple Markov property at a deterministic time `s ∈ [0, T]`, as independence of
the whole past path (the natural past, via `comap_restrict_eq_iSup_comap_eval`) and the whole
future increment path, together with the law of the future increment path. -/
theorem stableProcessLaw_simpleMarkov {θ T : ℝ} (hθ : 1 < θ ∧ θ ≤ 2) (hT : 0 < T)
    {s : ℝ} (hs : 0 ≤ s) (hsT : s ≤ T) :
    IndepFun (restrict (E := ℝ) hsT) (shiftIncrement hs hsT)
        (stableProcessLaw θ T : Measure (D T ℝ)) ∧
      (stableProcessLaw θ T).map (shiftIncrement hs hsT) =
        stableProcessLaw θ (T - s) := sorry

end BGW.StableTrees
