import BGW.ContinuumTrees.BrownianBridge
import BGW.Skorokhod.Continuous
import BGW.Skorokhod.Measurable
import BGW.Skorokhod.Restrict
import Mathlib.Probability.Distributions.Gaussian.Real

/-! Contract probe for CT.C19 (CT3): Brownian motion and Brownian bridge as laws on the
Skorokhod space `D T ℝ`, and the bridge prefix density. Intended maintained file:
`BGW/ContinuumTrees/BrownianD.lean`.

Conventions. The library's bridge `BrownianBridge.law` is the *standard* bridge, covariance
`min s t - s t` (variance `t(1-t)`), not the `√2`-scaled one. All laws below carry a scale
`c : ℝ≥0` multiplying the standard process, so variance of `X_t` is `c² t`; `c = 1` is standard
and `c = √2` is the stable convention `θ = 2` of the paper (Laplace exponent `ψ(λ) = λ²`).
Brownian motion on `[0,T]` is anchored as `B_t - B_0`, as in `BrownianBridge.path`. -/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace BGW.ContinuumTrees.BrownianD

open BGW.Skorokhod

/-- Anchored Brownian path on `[0,T]` as a continuous function, from the constructed
`ProbabilityTheory.brownian`. -/
noncomputable def brownianPath (T : ℝ) (ω : ℝ≥0 → ℝ) : C(Set.Icc (0 : ℝ) T, ℝ) where
  toFun t := brownian ⟨t.1, t.2.1⟩ ω - brownian 0 ω
  continuous_toFun := sorry

/-- Continuous paths are Borel-measurably embedded in Skorokhod space. -/
theorem measurable_ofContinuous {T : ℝ} :
    Measurable (ofContinuous : C(Set.Icc (0 : ℝ) T, ℝ) → D T ℝ) := sorry

theorem measurable_brownianPath (T : ℝ) : Measurable (brownianPath T) := sorry

/-- Restriction `D T ℝ → D a ℝ` is Borel measurable (both σ-algebras are generated by
evaluations). -/
theorem measurable_restrict {T a : ℝ} (haT : a ≤ T) :
    Measurable (restrict (E := ℝ) haT) := sorry

/-- The law of `c · B` on `[0,T]` in `C([0,T], ℝ)`. -/
noncomputable def wienerPathLaw (c : ℝ≥0) (T : ℝ) : ProbabilityMeasure C(Set.Icc (0 : ℝ) T, ℝ) :=
  ⟨Measure.map (fun ω => (c : ℝ) • brownianPath T ω) gaussianLimit, sorry⟩

/-- The law of `c · B` on `[0,T]` as a probability measure on `D([0,T], ℝ)`: Brownian motion with
variance `c² t`, pushed forward by `ofContinuous` (C19). -/
noncomputable def wienerD (c : ℝ≥0) (T : ℝ) : ProbabilityMeasure (D T ℝ) :=
  ⟨Measure.map ofContinuous (wienerPathLaw c T : Measure C(Set.Icc (0 : ℝ) T, ℝ)), sorry⟩

/-- The law of `c ·` (standard Brownian bridge) on `D([0,1], ℝ)`, pushed forward from
`BrownianBridge.law` by scaling and `ofContinuous` (C19). -/
noncomputable def bridgeD (c : ℝ≥0) : ProbabilityMeasure (D 1 ℝ) :=
  ⟨Measure.map (fun g : C(unitInterval, ℝ) => ofContinuous (T := 1) ((c : ℝ) • g))
    (BrownianBridge.law : Measure C(unitInterval, ℝ)), sorry⟩

/-! ### Basic properties of `wienerD` -/

theorem coe_wienerD (c : ℝ≥0) (T : ℝ) :
    (wienerD c T : Measure (D T ℝ)) =
      Measure.map ofContinuous (wienerPathLaw c T : Measure C(Set.Icc (0 : ℝ) T, ℝ)) := rfl

/-- The law is carried by continuous paths. -/
theorem ae_mem_range_ofContinuous_wienerD (c : ℝ≥0) (T : ℝ) :
    ∀ᵐ f ∂(wienerD c T : Measure (D T ℝ)),
      f ∈ Set.range (ofContinuous : C(Set.Icc (0 : ℝ) T, ℝ) → D T ℝ) := sorry

/-- Brownian motion starts at zero. -/
theorem ae_eval_zero_wienerD (c : ℝ≥0) {T : ℝ} (hT : 0 ≤ T) :
    ∀ᵐ f ∂(wienerD c T : Measure (D T ℝ)), f ⟨0, le_rfl, hT⟩ = 0 := sorry

/-- All finite-dimensional laws are centered Gaussian. -/
theorem isGaussianProcess_eval_wienerD (c : ℝ≥0) (T : ℝ) :
    IsGaussianProcess (fun (t : Set.Icc (0 : ℝ) T) (f : D T ℝ) => f t)
      (wienerD c T : Measure (D T ℝ)) := sorry

theorem integral_eval_wienerD (c : ℝ≥0) {T : ℝ} (t : Set.Icc (0 : ℝ) T) :
    ∫ f : D T ℝ, f t ∂(wienerD c T : Measure (D T ℝ)) = 0 := sorry

/-- Covariance `c² min(s,t)`. -/
theorem covariance_eval_wienerD (c : ℝ≥0) {T : ℝ} (s t : Set.Icc (0 : ℝ) T) :
    cov[fun f : D T ℝ => f s, fun f : D T ℝ => f t; (wienerD c T : Measure (D T ℝ))] =
      (c : ℝ) ^ 2 * min (s : ℝ) (t : ℝ) := sorry

/-- The `√2` normalization: `X = √2 B` has Laplace exponent `λ ↦ λ²`, i.e. `E e^{-λ X_t} = e^{t λ²}`,
the stable convention `ψ(λ) = λ^θ` with `θ = 2`. -/
theorem integral_exp_neg_eval_wienerD_sqrt_two {T : ℝ} (t : Set.Icc (0 : ℝ) T) (l : ℝ) :
    ∫ f : D T ℝ, Real.exp (-l * f t) ∂(wienerD (NNReal.sqrt 2) T : Measure (D T ℝ)) =
      Real.exp ((t : ℝ) * l ^ 2) := sorry

/-! ### Basic properties of `bridgeD` -/

theorem coe_bridgeD (c : ℝ≥0) :
    (bridgeD c : Measure (D 1 ℝ)) =
      Measure.map (fun g : C(unitInterval, ℝ) => ofContinuous (T := 1) ((c : ℝ) • g))
        (BrownianBridge.law : Measure C(unitInterval, ℝ)) := rfl

/-- The law is carried by continuous paths. -/
theorem ae_mem_range_ofContinuous_bridgeD (c : ℝ≥0) :
    ∀ᵐ f ∂(bridgeD c : Measure (D 1 ℝ)),
      f ∈ Set.range (ofContinuous : C(Set.Icc (0 : ℝ) 1, ℝ) → D 1 ℝ) := sorry

/-- Both endpoints vanish. -/
theorem ae_endpoints_bridgeD (c : ℝ≥0) :
    ∀ᵐ f ∂(bridgeD c : Measure (D 1 ℝ)),
      f ⟨0, by norm_num, by norm_num⟩ = 0 ∧ f ⟨1, by norm_num, le_rfl⟩ = 0 := sorry

theorem isGaussianProcess_eval_bridgeD (c : ℝ≥0) :
    IsGaussianProcess (fun (t : Set.Icc (0 : ℝ) 1) (f : D 1 ℝ) => f t)
      (bridgeD c : Measure (D 1 ℝ)) := sorry

theorem integral_eval_bridgeD (c : ℝ≥0) (t : Set.Icc (0 : ℝ) 1) :
    ∫ f : D 1 ℝ, f t ∂(bridgeD c : Measure (D 1 ℝ)) = 0 := sorry

/-- Covariance `c² (min(s,t) - s t)` (the library's standard bridge when `c = 1`). -/
theorem covariance_eval_bridgeD (c : ℝ≥0) (s t : Set.Icc (0 : ℝ) 1) :
    cov[fun f : D 1 ℝ => f s, fun f : D 1 ℝ => f t; (bridgeD c : Measure (D 1 ℝ))] =
      (c : ℝ) ^ 2 * (min (s : ℝ) (t : ℝ) - (s : ℝ) * (t : ℝ)) := sorry

/-- Relation between the bridge and Brownian motion in distribution: the law of `X_t`, `t ≤ 1`,
under the bridge is the centered Gaussian of variance `c² t (1 - t)`. -/
theorem map_eval_bridgeD (c : ℝ≥0) (t : Set.Icc (0 : ℝ) 1) :
    (bridgeD c : Measure (D 1 ℝ)).map (fun f : D 1 ℝ => f t) =
      gaussianReal 0 (c ^ 2 * ⟨(t : ℝ) * (1 - t), mul_nonneg t.2.1 (sub_nonneg.2 t.2.2)⟩) := sorry

/-! ### Prefix density of the bridge with respect to Brownian motion -/

/-- The Gaussian variance `c² t` (with `t` truncated at `0`). -/
noncomputable def variance (c : ℝ≥0) (t : ℝ) : ℝ≥0 := c ^ 2 * Real.toNNReal t

/-- The density `p_{c²(1-a)}(-x) / p_{c²}(0)` of the bridge prefix on `[0,a]` with respect to
Brownian motion on `[0,a]`, evaluated at the terminal value `x = f(a)`. -/
noncomputable def prefixDensity (c : ℝ≥0) (a x : ℝ) : ℝ :=
  gaussianPDFReal 0 (variance c (1 - a)) (-x) / gaussianPDFReal 0 (variance c 1) 0

/-- Explicit form of the prefix density: `(1-a)^{-1/2} exp (-x² / (2 c² (1-a)))`. -/
theorem prefixDensity_eq {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha : a < 1) (x : ℝ) :
    prefixDensity c a x =
      (1 - a) ^ (-(1 / 2 : ℝ)) * Real.exp (-x ^ 2 / (2 * (c : ℝ) ^ 2 * (1 - a))) := sorry

/-- The prefix density is a probability density for Brownian motion on `[0,a]`. -/
theorem lintegral_prefixDensity_wienerD {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha0 : 0 ≤ a)
    (ha1 : a < 1) :
    ∫⁻ f, ENNReal.ofReal (prefixDensity c a (f ⟨a, ha0, le_rfl⟩))
      ∂(wienerD c a : Measure (D a ℝ)) = 1 := sorry

/-- **Bridge prefix density (C19).** For `0 ≤ a < 1`, the law of the bridge restricted to `[0,a]`
is absolutely continuous with respect to Brownian motion on `[0,a]`, with density
`p_{c²(1-a)}(-X_a) / p_{c²}(0)`. -/
theorem map_restrict_bridgeD_eq_withDensity {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha0 : 0 ≤ a)
    (ha1 : a < 1) :
    (bridgeD c : Measure (D 1 ℝ)).map (restrict (E := ℝ) ha1.le) =
      (wienerD c a : Measure (D a ℝ)).withDensity
        (fun f => ENNReal.ofReal (prefixDensity c a (f ⟨a, ha0, le_rfl⟩))) := sorry

/-- Absolute continuity of the bridge prefix. -/
theorem map_restrict_bridgeD_absolutelyContinuous {c : ℝ≥0} (hc : c ≠ 0) {a : ℝ} (ha0 : 0 ≤ a)
    (ha1 : a < 1) :
    (bridgeD c : Measure (D 1 ℝ)).map (restrict (E := ℝ) ha1.le) ≪
      (wienerD c a : Measure (D a ℝ)) := sorry

end BGW.ContinuumTrees.BrownianD
