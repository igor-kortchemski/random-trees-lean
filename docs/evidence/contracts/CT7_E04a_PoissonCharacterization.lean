import Mathlib.Probability.Distributions.Poisson.Basic
import Mathlib.Probability.Independence.Basic
import Mathlib.MeasureTheory.Measure.GiryMonad
import Mathlib.MeasureTheory.Constructions.Pi

/-! Contract probe for CT7 node E04a (generic finite-rate characterization of a Poisson random
measure on `ℝ≥0 × M`), with the TIME-SIMPLICITY hypothesis of AUDIT finding 1.  Mathlib-only; no
BGW imports.

FORMULATION CHOICE (flagged).  A random point measure is a measurable map
`ξ : Ω → Measure (ℝ≥0 × M)` (Mathlib's `Measure` carries the evaluation `σ`-algebra, so counts
`ω ↦ ξ ω B` are measurable for measurable `B`).  Counts are `ℝ≥0∞`-valued and are read in `ℕ` by
`natCount` only on sets of a.s. finite count.  No simplicity of the ambient measure is built
in; instead the AUDIT's counterexample (two marks at every arrival of a rate-one Poisson process)
is ruled out by `timeSimple`: a.s. at most one mark per time label, over the whole mark space.

Hypotheses (all on the ambient space `ℝ≥0 × M`, the sets `A ⊆ M` of FINITE-RATE marks are
parameters, as for `{ζ > ε}` in E04):
* `measurable`, `atZero` (zero mass at label 0), `counting` (AUDIT 2: a.s. `ξ ω` is a COUNTING
  measure, a sum of unit Dirac masses at the points of a countable set; without it the
  deterministic `ξ = Lebesgue × δ★` satisfies every other hypothesis and every Poisson statement
  fails), `timeSimple`;
* `stationary`: the translated restriction to a window `(a, a+h]` has the law of the restriction
  to `(0, h]`; `indep`: restrictions to disjoint consecutive windows are independent;
* `IsFiniteRate`: `A` measurable with `ξ((0,t] × A) < ∞` a.s. for each `t`.
Stochastic continuity at `0` and absence of deterministic-time atoms are DERIVED
(`tendsto_prob_mark_window`, `ae_not_mark_at`) from local finiteness plus no atom at `0`, as the
AUDIT directs.

The rate of `A` is `markRate P ξ A = E ξ((0,1] × A)`; the Poisson parameter of a box
`(s,t] × A` is `(t - s) * markRate`.  The deterministic-history compensation uses the natural
history `naturalHistory ξ t = σ(ξ restricted to [0,t] × M)`; compensation relative to the larger
stopped filtration `G_x = F_{T_x}` is the later E03-dependent instantiation (AUDIT item 4).

PROOF NOTE (window vs. `Iic`).  `naturalHistory ξ s` restricts to `Iic s ×ˢ univ = [0,s] × M`,
whereas the independence/stationarity hypotheses concern windows `(0,s]`.  The two restrictions
agree only almost surely (by `atZero` there is no mass at label `0`), so every use of the history
for compensation (`lintegral_mul_count_window`) first replaces the `[0,s]`-restriction by the
`(0,s]`-window restriction off a `P`-null set; `naturalHistory` is not null-completed.
Truth of the statements: with `counting` and `timeSimple`, each count `t ↦ ξ((0,t] × A)` is an
integer-valued Lévy (stationary independent increments, stochastically continuous by
`tendsto_prob_mark_window`) process with jumps `≤ 1` on a finite-rate `A`, hence Poisson; counts on
disjoint boxes are independent because, by time-simplicity, two different mark sets never jump at
the same time.
Estimate 700-1100 lines. -/

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped NNReal ENNReal

namespace BGW.StableTrees

variable {Ω M : Type*} [MeasurableSpace Ω] [MeasurableSpace M]

/-- The count of a set read in `ℕ` (junk `0` for an infinite count, a.s. irrelevant). -/
noncomputable def natCount (μ : Measure (ℝ≥0 × M)) (B : Set (ℝ≥0 × M)) : ℕ :=
  ⌊ENNReal.toNNReal (μ B)⌋₊

/-- The restriction of a point measure to the time window `(a, b]` (all marks). -/
noncomputable def windowRestrict (a b : ℝ≥0) (μ : Measure (ℝ≥0 × M)) : Measure (ℝ≥0 × M) :=
  μ.restrict (Ioc a b ×ˢ univ)

/-- The same window, translated to start at time `0`. -/
noncomputable def windowShift (a b : ℝ≥0) (μ : Measure (ℝ≥0 × M)) : Measure (ℝ≥0 × M) :=
  Measure.map (fun p : ℝ≥0 × M => (p.1 - a, p.2)) (windowRestrict a b μ)

set_option warn.classDefReducibility false in
/-- The natural history of `ξ` up to time `t`: the `σ`-algebra generated by `ξ` restricted to
`[0,t] × M`. -/
noncomputable def naturalHistory (ξ : Ω → Measure (ℝ≥0 × M)) (t : ℝ≥0) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (ξ ω).restrict (Iic t ×ˢ univ)) inferInstance

/-- **Time-simple finite-rate random point measure**: the structural hypotheses of E04a. -/
structure IsTimeSimpleLevy (P : Measure Ω) (ξ : Ω → Measure (ℝ≥0 × M)) : Prop where
  measurable : Measurable ξ
  /-- zero mass at label `0` -/
  atZero : ∀ᵐ ω ∂P, ξ ω ({0} ×ˢ univ) = 0
  /-- **counting measure** (AUDIT 2): a.s. `ξ ω` is the sum of unit Dirac masses at the points of
  a countable set `S ⊆ ℝ≥0 × M` (no multiplicities, no diffuse part). -/
  counting : ∀ᵐ ω ∂P, ∃ S : Set (ℝ≥0 × M), S.Countable ∧
    ξ ω = Measure.sum (fun p : S => Measure.dirac (p : ℝ≥0 × M))
  /-- **time-simplicity** (AUDIT finding 1): a.s. at most one mark per time label -/
  timeSimple : ∀ᵐ ω ∂P, ∀ s : ℝ≥0, ξ ω ({s} ×ˢ univ) ≤ 1
  /-- stationarity of window restrictions -/
  stationary : ∀ a h : ℝ≥0,
    P.map (fun ω => windowShift a (a + h) (ξ ω)) = P.map (fun ω => windowShift 0 h (ξ ω))
  /-- independence of restrictions to consecutive windows -/
  indep : ∀ (n : ℕ) (t : Fin (n + 1) → ℝ≥0), Monotone t →
    iIndepFun (fun i : Fin n => fun ω => windowRestrict (t i.castSucc) (t i.succ) (ξ ω)) P

/-- A measurable set of marks of finite rate: finitely many marks in `(0,t] × A` a.s. -/
def IsFiniteRate (P : Measure Ω) (ξ : Ω → Measure (ℝ≥0 × M)) (A : Set M) : Prop :=
  MeasurableSet A ∧ ∀ t : ℝ≥0, ∀ᵐ ω ∂P, ξ ω (Ioc 0 t ×ˢ A) < ⊤

/-- The mark rate of `A`: `E ξ((0,1] × A)`. -/
noncomputable def markRate (P : Measure Ω) (ξ : Ω → Measure (ℝ≥0 × M)) (A : Set M) : ℝ≥0∞ :=
  ∫⁻ ω, ξ ω (Ioc 0 1 ×ˢ A) ∂P

variable {P : Measure Ω} [IsProbabilityMeasure P] {ξ : Ω → Measure (ℝ≥0 × M)} {A : Set M}

/-- **No deterministic-time atom** (derived): for fixed `s`, a.s. no mark at label `s`. -/
theorem ae_not_mark_at (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A) (s : ℝ≥0) :
    ∀ᵐ ω ∂P, ξ ω ({s} ×ˢ A) = 0 := sorry

/-- **Stochastic continuity at zero** (derived from local finiteness and no atom at `0`): the
probability of at least one `A`-mark in `(0, h]` tends to `0` as `h ↓ 0`. -/
theorem tendsto_prob_mark_window (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A) :
    Tendsto (fun h : ℝ≥0 => P {ω | 1 ≤ ξ ω (Ioc 0 h ×ˢ A)}) (𝓝[>] 0) (𝓝 0) := sorry

/-- **Small-interval multiple-arrival estimate**: `P(≥ 2 marks in (0,h]) = o(h)`; this is the
step that uses time-simplicity (supplied inside the proof, not as an axiom). -/
theorem prob_two_marks_window_isLittleO (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A) :
    Tendsto (fun h : ℝ≥0 => (P {ω | 2 ≤ ξ ω (Ioc 0 h ×ˢ A)}).toReal / (h : ℝ))
      (𝓝[>] 0) (𝓝 0) := sorry

/-- **No-arrival exponential law**: `P(no A-mark in (0,t]) = exp(-t λ_A)`, with `λ_A` finite. -/
theorem prob_noMark_window (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A) (t : ℝ≥0) :
    P {ω | ξ ω (Ioc 0 t ×ˢ A) = 0} =
      ENNReal.ofReal (Real.exp (-((t : ℝ) * (markRate P ξ A).toReal))) := sorry

/-- **Finite expected intensity** of a finite-rate mark set. -/
theorem markRate_lt_top (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A) :
    markRate P ξ A < ⊤ := sorry

/-- **Expected count on a window**: `E ξ((s,t] × A) = (t - s) λ_A`. -/
theorem lintegral_count_window (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A)
    {s t : ℝ≥0} (hst : s ≤ t) :
    ∫⁻ ω, ξ ω (Ioc s t ×ˢ A) ∂P = ((t - s : ℝ≥0) : ℝ≥0∞) * markRate P ξ A := sorry

/-- **Finite-mark partition pgf.** For finitely many boxes `(s i, t i] × A i`, pairwise disjoint
as subsets of `ℝ≥0 × M` and with finite-rate `A i`, and `z i ∈ [0,1]`:
`E ∏ z_i^{N_i} = exp(∑ (t_i - s_i) λ_{A_i} (z_i - 1))`. -/
theorem pgf_finite_partition (hξ : IsTimeSimpleLevy P ξ) {k : ℕ} (A : Fin k → Set M)
    (hA : ∀ i, IsFiniteRate P ξ (A i)) (s t : Fin k → ℝ≥0) (hst : ∀ i, s i ≤ t i)
    (hdisj : Pairwise (Function.onFun Disjoint fun i => Ioc (s i) (t i) ×ˢ A i))
    (z : Fin k → ℝ) (hz0 : ∀ i, 0 ≤ z i) (hz1 : ∀ i, z i ≤ 1) :
    ∫ ω, ∏ i, z i ^ natCount (ξ ω) (Ioc (s i) (t i) ×ˢ A i) ∂P =
      Real.exp (∑ i, ((t i - s i : ℝ≥0) : ℝ) * (markRate P ξ (A i)).toReal * (z i - 1)) := sorry

/-- **Independent Poisson counts** on finitely many disjoint finite-rate boxes. -/
theorem counts_poisson_independent (hξ : IsTimeSimpleLevy P ξ) {k : ℕ} (A : Fin k → Set M)
    (hA : ∀ i, IsFiniteRate P ξ (A i)) (s t : Fin k → ℝ≥0) (hst : ∀ i, s i ≤ t i)
    (hdisj : Pairwise (Function.onFun Disjoint fun i => Ioc (s i) (t i) ×ˢ A i)) :
    P.map (fun ω i => natCount (ξ ω) (Ioc (s i) (t i) ×ˢ A i)) =
      Measure.pi (fun i => poissonMeasure ((t i - s i) * (markRate P ξ (A i)).toNNReal)) := sorry

/-- **Deterministic-history compensation** (step tests): for `Y ≥ 0` measurable for the natural
history at time `s`, `E[Y ξ((s,t] × A)] = E[Y] (t - s) λ_A`. -/
theorem lintegral_mul_count_window (hξ : IsTimeSimpleLevy P ξ) (hA : IsFiniteRate P ξ A)
    {s t : ℝ≥0} (hst : s ≤ t) {Y : Ω → ℝ≥0∞} (hY : Measurable[naturalHistory ξ s] Y) :
    ∫⁻ ω, Y ω * ξ ω (Ioc s t ×ˢ A) ∂P =
      (∫⁻ ω, Y ω ∂P) * (((t - s : ℝ≥0) : ℝ≥0∞) * markRate P ξ A) := sorry

end BGW.StableTrees
